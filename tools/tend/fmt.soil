; SPDX-License-Identifier: MIT OR Apache-2.0
; Soil formatter.
;
; Formatting works from the token stream, not from evaluated values, so nested
; comments and quote spelling survive. The layout is intentionally conservative:
; special forms we know are laid out; everything else stays inline when short
; and becomes a two-space-indented list when not.

(defun tend/count (values)
  (if (nil? values) 0 (+ 1 (tend/count (rest values)))))

(defun tend/spaces (n)
  (if (<= n 0) "" (str " " (tend/spaces (- n 1)))))

(defun tend/token-kind (token) (field token :kind))
(defun tend/token-text (token) (field token :text))

(defun tend/atom-node (token)
  (list
    (list :kind "atom")
    (list :text (tend/token-text token))))

(defun tend/comment-node (token)
  (list
    (list :kind "comment")
    (list :text (tend/token-text token))))

(defun tend/prefix-node (token child)
  (list
    (list :kind "prefix")
    (list :text (tend/token-text token))
    (list :node child)))

(defun tend/list-node (items)
  (list
    (list :kind "list")
    (list :items items)))

(defun tend/parse-tokens (tokens items)
  (if (nil? tokens)
      (list (reverse items) nil)
      (let ((kind (tend/token-kind (first tokens))))
        (cond
          ((= kind "close")
            (list (reverse items) (rest tokens)))
          (else
            (let ((parsed (tend/parse-node tokens)))
              (tend/parse-tokens
                (nth 1 parsed)
                (cons (first parsed) items))))))))

(defun tend/parse-node (tokens)
  (let ((token (first tokens))
        (kind (tend/token-kind (first tokens))))
    (cond
      ((= kind "comment")
        (list (tend/comment-node token) (rest tokens)))
      ((= kind "open")
        (let ((parsed (tend/parse-tokens (rest tokens) nil)))
          (list (tend/list-node (first parsed)) (nth 1 parsed))))
      ((= kind "prefix")
        (let ((child (tend/parse-node (rest tokens))))
          (list (tend/prefix-node token (first child)) (nth 1 child))))
      (else
        (list (tend/atom-node token) (rest tokens))))))

(defun tend/nodes (tokens)
  (first (tend/parse-tokens tokens nil)))

(defun tend/node-kind (node) (field node :kind))
(defun tend/node-text (node) (field node :text))
(defun tend/node-items (node) (field node :items))
(defun tend/node-child (node) (field node :node))

(defun tend/comments? (nodes)
  (if (nil? nodes)
      #f
      (if (= (tend/node-kind (first nodes)) "comment")
          #t
          (tend/comments? (rest nodes)))))

(defun tend/inline-node? (node)
  (cond
    ((= (tend/node-kind node) "comment") #f)
    ((= (tend/node-kind node) "prefix") (tend/inline-node? (tend/node-child node)))
    ((= (tend/node-kind node) "list")
      (let ((items (tend/node-items node)))
        (and (not (tend/comments? items))
             (<= (tend/count items) 5)
             (tend/all-inline? items))))
    (else #t)))

(defun tend/all-inline? (nodes)
  (if (nil? nodes)
      #t
      (and (tend/inline-node? (first nodes))
           (tend/all-inline? (rest nodes)))))

(defun tend/inline-nodes (nodes out)
  (if (nil? nodes)
      out
      (tend/inline-nodes (rest nodes)
        (if (= out "")
            (tend/fmt-node (first nodes) 0)
            (str out " " (tend/fmt-node (first nodes) 0))))))

(defun tend/head (node)
  (if (= (tend/node-kind node) "list")
      (let ((items (tend/node-items node)))
        (if (nil? items) nil
            (let ((first-node (first items)))
              (if (= (tend/node-kind first-node) "atom")
                  (tend/node-text first-node)
                  nil))))
      nil))

(defun tend/body-text (nodes indent)
  (if (nil? nodes)
      ""
      (str (tend/spaces indent)
           (if (= (tend/node-kind (first nodes)) "comment")
               (tend/node-text (first nodes))
               (tend/fmt-node (first nodes) indent))
           "\n"
           (tend/body-text (rest nodes) indent))))

(defun tend/fmt-special (head node indent)
  (let ((items (tend/node-items node)))
    (cond
      ((= head "defun")
        (let ((name (nth 1 items))
              (params (nth 2 items))
              (body (drop 3 items)))
          (str "(defun " (tend/fmt-node name 0) " " (tend/fmt-node params 0)
               (if (nil? body) ")" (str "\n"
                 (tend/body-text body (+ indent 2))
                 (tend/spaces indent) ")")))))
      ((= head "let")
        (let ((bindings (nth 1 items))
              (body (drop 2 items)))
          (str "(let " (tend/fmt-node bindings 0) "\n"
               (tend/body-text body (+ indent 2))
               (tend/spaces indent) ")")))
      ((= head "if")
        (let ((cond (nth 1 items))
              (body (drop 2 items)))
          (str "(if " (tend/fmt-node cond 0) "\n"
               (tend/body-text body (+ indent 2))
               (tend/spaces indent) ")")))
      ((= head "cond")
        (let ((clauses (drop 1 items)))
          (str "(cond\n"
               (tend/body-text clauses (+ indent 2))
               (tend/spaces indent) ")")))
      ((or (= head "begin") (= head "do"))
        (let ((body (drop 1 items)))
          (str "(" head "\n"
               (tend/body-text body (+ indent 2))
               (tend/spaces indent) ")")))
      (else nil))))

(defun tend/fmt-list (node indent)
  (let ((items (tend/node-items node))
        (head (tend/head node)))
    (cond
      ((nil? items) "()")
      ((and (not (nil? head))
            (not (nil? (tend/fmt-special head node indent))))
        (tend/fmt-special head node indent))
      ((tend/inline-node? node) (str "(" (tend/inline-nodes items "") ")"))
      (else
        (str "(" (tend/fmt-node (first items) 0)
             "\n"
             (tend/body-text (rest items) (+ indent 2))
             (tend/spaces indent) ")")))))

(defun tend/fmt-node (node indent)
  (cond
    ((= (tend/node-kind node) "atom") (tend/node-text node))
    ((= (tend/node-kind node) "comment") (tend/node-text node))
    ((= (tend/node-kind node) "prefix")
      (str (tend/node-text node) (tend/fmt-node (tend/node-child node) indent)))
    (else (tend/fmt-list node indent))))

(defun tend/fmt-nodes (nodes out)
  (if (nil? nodes)
      out
      (let ((node (first nodes)))
        (if (= (tend/node-kind node) "comment")
            (tend/fmt-nodes (rest nodes) (str out (tend/node-text node) "\n"))
            (tend/fmt-nodes (rest nodes)
              (str out (tend/fmt-node node 0)
                   (if (nil? (rest nodes)) "\n" "\n\n")))))))

(defun tend/fmt (source)
  (let ((document (read-document source)))
    (str (tend/fmt-nodes (tend/nodes (field document :tokens)) ""))))
