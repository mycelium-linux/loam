; SPDX-License-Identifier: MIT OR Apache-2.0
; Editable copy for soil-lang.org.
;
; Structure, tags, and CSS classes live in soil-lang.soil. This file owns the
; words: nav labels, headings, prose, cards, and code samples. Change text here
; and rebuild; the landing page picks it up.

(defconst site-copy
  (list
    (list :site
      (list
        (list :title "Soil — a small Lisp for tools you can read")))

    (list :nav
      (list
        (list :why "Why Soil")
        (list :substrate "Substrate")
        (list :learn "Learn")
        (list :api "API")
        (list :examples "Examples")
        (list :spores "Spores")
        (list :community "Community")
        (list :github "GitHub")))

    (list :hero
      (list
        (list :kicker "SOIL-LANG.ORG")
        (list :title-prefix "A small Lisp for ")
        (list :title-accent "tools you can read.")
        (list :lede "Soil is a homoiconic Lisp with typed host capabilities. Code is data, macros are ordinary forms, and the boundary to the machine is explicit. The same program runs natively or in the browser.")
        (list :primary-label "Read the guide")
        (list :github-label "View on GitHub")
        (list :meta-prefix "In the Lisp family. ")
        (list :meta-link-label "lisp-lang.org")
        (list :meta-suffix " · MIT OR Apache-2.0 · Rust core · native and WASM hosts")
        (list :code-name "counter.soil")
        (list :code "(defun view (state)\n  (el \"div\" (list (attr :class \"app\"))\n    (list\n      (el \"output\" (list (attr :class \"value\"))\n        (list (txt state)))\n      (el \"button\" (list (attr :data-op \"inc\"))\n        (list (txt \"+\"))))))")
        (list :code-foot "→ real HTML and CSS. No virtual DOM required.")))

    (list :why
      (list
        (list :kicker "WHY SOIL")
        (list :title "Small core. Visible seams.")
        (list :body "The runtime is small enough to read. There is no framework between the form and the machine; host capabilities are the only edges that need a contract.")
        (list :items
          (list
            (list
              (list :number "01")
              (list :title "Homoiconic")
              (list :body "The source, the AST, the docs, and the UI are the same tree. A tool can read and rewrite itself without a second representation."))
            (list
              (list :number "02")
              (list :title "Editable")
              (list :body "Every form carries a source span. An editor can replace one form and keep the comments, layout, and everything it did not touch."))
            (list
              (list :number "03")
              (list :title "Portable")
              (list :body "One WIT contract, two hosts. The same Lisp runs natively and in the browser; the GPU stays an optional capability, not a requirement."))))))

    (list :substrate
      (list
        (list :kicker "THE SUBSTRATE")
        (list :title "Lisp, with a typed host boundary.")
        (list :body "Lisp gave us code as data, macros, and a live system. Soil keeps that and makes the edges explicit: capabilities are typed, GPU views are optional, and a spore's hash is its name.")
        (list :items
          (list
            (list
              (list :number "01")
              (list :title "Lisp, kept intact")
              (list :body "Homoiconic forms, macros, a small core, and a REPL-shaped workflow. The source, the docs, and the UI do not fork into separate representations."))
            (list
              (list :number "02")
              (list :title "GPU when it matters")
              (list :body "Canvas and GPU-resident scenes are a host capability. Trees, forms, and docs stay ordinary HTML/CSS; waveforms and schematics stay on the GPU."))
            (list
              (list :number "03")
              (list :title "Boundaries and distance")
              (list :body "WIT makes capabilities typed and portable. Spores are content-addressed, so the same artifact can run on this machine or another host."))))))

    (list :learn
      (list
        (list :kicker "LEARN")
        (list :title "From a form to a running tool.")
        (list :body "Start with the language, then the host, then a spore. You do not need a framework to put a real interface on screen.")
        (list :steps
          (list
            (list
              (list :number "01")
              (list :title "Read the roadmap")
              (list :body "Phases from the core language to self-hosting, with done criteria."))
            (list
              (list :number "02")
              (list :title "Run an example")
              (list :body "Counter, TODO, calculator, tic-tac-toe. All of them are plain .soil."))
            (list
              (list :number "03")
              (list :title "Write a spore")
              (list :body "One manifest and one entry form. A library and an app are the same artifact."))))
        (list :code ";; tend build\n;; tend run\n\n(defun view (state)\n  (el \"main\" (list (attr :class \"app\"))\n    (list\n      (el \"h1\" nil (list (txt \"Hello from Soil\")))\n      (el \"p\" nil (list (txt \"This is a form, not a template.\"))))))")))

    (list :examples
      (list
        (list :kicker "EXAMPLES")
        (list :title "Six tools, inline.")
        (list :body "These are the actual Soil widgets, built from the same forms as the rest of the page.")
        (list :items
          (list
            (list (list :slug "todo") (list :title "TODO"))
            (list (list :slug "counter") (list :title "Counter"))
            (list (list :slug "calculator") (list :title "Calculator"))
            (list (list :slug "tictactoe") (list :title "Tic-tac-toe"))
            (list (list :slug "tabs") (list :title "Tabs"))
            (list (list :slug "form") (list :title "Form"))))))

    (list :spores
      (list
        (list :kicker "SPORES")
        (list :title "A library and an app are the same file.")
        (list :cards
          (list
            (list
              (list :title "Load it for its functions")
              (list :body "A spore that exports forms is a library. Require it, call its functions, compose its views."))
            (list
              (list :title "Launch it for its entry point")
              (list :body "The same spore with a start form is an app. tend resolves it, builds it, and runs it here or on another host."))))))

    (list :community
      (list
        (list :kicker "COMMUNITY")
        (list :title "Bring a hard question.")
        (list :body "Soil is free software. The core is small on purpose. Bring a spore, a capability, or a question that the current tools cannot answer.")
        (list :primary-label "GitHub")
        (list :secondary-label "Issues")))

    (list :footer
      (list
        (list :left "Soil · soil-lang.org")
        (list :license "MIT OR Apache-2.0")))))

;;; Read one section or one key inside a section from `site-copy`.
(defun copy (section key)
  (field (field site-copy section) key))
