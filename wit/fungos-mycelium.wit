// Mycelium control-plane capabilities exposed to Spores.
//
// This is not the host directory/session surface in `soil:mycelium`. This
// package is for daemon-owned control-plane state: schedules, runs and the
// system tasks that share the same clock. The host bridges it to myceliumd;
// the Spore never sees a socket, a store path or a node key.
package fungos:mycelium@0.1.0;

interface pulse {
  enum error {
    denied,
    invalid,
    not-found,
    unavailable,
    io,
  }

  record cron {
    id: string,
    schedule: string,
    command: string,
    enabled: bool,
    next-at-ms: option<u64>,
    last-fired-ms: u64,
  }

  record system-pulse {
    id: string,
    interval-secs: u64,
    description: string,
  }

  record snapshot {
    system: list<system-pulse>,
    user: list<cron>,
  }

  record run {
    id: string,
    pulse-id: string,
    scheduled-at-ms: u64,
    fired-at-ms: u64,
    finished-at-ms: u64,
    outcome: string,
    detail: string,
  }

  /// System and user pulses. System entries are read-only.
  all: func() -> result<snapshot, error>;

  /// Create or replace a user pulse. The host validates the cron expression
  /// and the command before persisting it.
  put: func(pulse: cron) -> result<cron, error>;

  /// Remove a user pulse by id.
  remove: func(id: string) -> result<bool, error>;

  /// Run history, newest first. `id` filters to one user pulse.
  runs: func(id: option<string>, limit: u32) -> result<list<run>, error>;
}

/// Live fleet state from the Mycelium control plane.
///
/// The host owns the daemon call and returns a bounded projection: peer facts
/// and four topology counts, never the megabyte topology document. A Spore
/// names this interface; it never sees the mycelium binary, a socket, a store
/// path or a node key.
interface fleet {
  enum error {
    denied,
    invalid,
    unavailable,
    io,
  }

  record peer {
    id: string,
    hostname: option<string>,
    site: option<string>,
    platform: option<string>,
    architecture: option<string>,
    daemon-version: option<string>,
    release-version: option<string>,
    last-seen: option<u64>,
    ssh-listening: option<bool>,
    update-state: option<string>,
  }

  /// Four counts, not the topology document: what a wall can read and a Spore
  /// has no business holding.
  record topology {
    nodes: u32,
    segments: u32,
    conflicts: u32,
    leases: u32,
  }

  record snapshot {
    /// Host clock at the read. The view never reads a clock of its own.
    captured-ms: u64,
    peers: list<peer>,
    topology: option<topology>,
  }

  /// Read the current fleet. The host may serve a short-lived cache; the
  /// contract is a live read, not a captured fixture.
  status: func() -> result<snapshot, error>;
}

world fleet-host {
  import fleet;
}
