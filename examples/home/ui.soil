; SPDX-License-Identifier: MIT OR Apache-2.0
; SSR components for the home snapshot. The data comes from home.soil; these
; functions decide layout and text only.

(defun home/or (value fallback)
  (if (nil? value) fallback value))

(defun home/state-text (status)
  (if (field status :playing) "playing" "paused"))

(defun home/styles ()
  "
:root { color-scheme: dark; --bg:#0d1014; --panel:#161b22; --line:#28313d; --text:#e6edf3; --muted:#8b98a8; --warm:#f5c542; --cool:#58a6ff; }
* { box-sizing:border-box; }
body { margin:0; background:radial-gradient(circle at 20% 0%, #1a2330 0%, var(--bg) 45%); color:var(--text); font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif; }
main { max-width:1180px; margin:0 auto; padding:48px 24px 72px; }
.kicker { color:var(--warm); font-size:12px; letter-spacing:.18em; text-transform:uppercase; margin:0 0 8px; }
h1 { font-size:clamp(32px,5vw,64px); line-height:1; margin:0 0 12px; letter-spacing:-.04em; }
.lede { color:var(--muted); max-width:62ch; margin:0; }
.grid { display:grid; grid-template-columns:repeat(12,1fr); gap:18px; margin-top:36px; }
.card { background:linear-gradient(180deg, #1a2029, var(--panel)); border:1px solid var(--line); border-radius:18px; padding:22px; box-shadow:0 16px 40px rgba(0,0,0,.28); }
.room { grid-column:span 7; }
.player { grid-column:span 5; }
.cameras { grid-column:span 12; }
.card h2 { margin:0 0 4px; font-size:24px; letter-spacing:-.02em; }
.card p { color:var(--muted); margin:6px 0; }
.tag { display:inline-block; color:var(--bg); background:var(--warm); border-radius:999px; padding:3px 10px; font-size:12px; font-weight:700; }
.lights { list-style:none; padding:0; margin:18px 0 0; display:grid; gap:10px; }
.light { display:grid; grid-template-columns:1fr auto auto; gap:12px; align-items:center; padding:12px 14px; border:1px solid var(--line); border-radius:12px; background:#11161d; }
.light .name { font-weight:650; }
.light .bri { color:var(--warm); font-variant-numeric:tabular-nums; }
.light .mode { color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.08em; }
.light.off { opacity:.55; }
.queue { list-style:none; padding:0; margin:16px 0 0; border-top:1px solid var(--line); }
.queue li { display:grid; grid-template-columns:auto 1fr; gap:10px; padding:10px 0; border-bottom:1px solid var(--line); color:var(--muted); }
.queue li.current { color:var(--text); }
.queue .mark { color:var(--warm); }
.error { border-color:#6e2b2b; background:linear-gradient(180deg,#241416,#1a1113); }
.unavailable { color:var(--muted); }
@media (max-width:820px) { .room,.player { grid-column:span 12; } main { padding-top:28px; } }
")

(defun home/error-card (title message)
  (el "section" (list (attr :class "card error"))
    (list
      (el "p" (list (attr :class "kicker")) (list (txt "UNAVAILABLE")))
      (el "h2" nil (list (txt title)))
      (el "p" nil (list (txt message))))))

(defun home/light-row (light)
  (let ((state (field light :state)))
    (el "li" (list (attr :class (if (field state :on) "light on" "light off")))
      (list
        (el "span" (list (attr :class "name"))
          (list (txt (home/or (field light :name) (field light :id)))))
        (el "span" (list (attr :class "bri"))
          (list (txt (str "bri " (home/or (field state :bri) "-")))))
        (el "span" (list (attr :class "mode"))
          (list (txt (home/or (field state :colormode) "-"))))))))

(defun home/room-card (section)
  (if (field section :error)
      (home/error-card "Room" (field section :error))
      (let ((room (field section :room))
            (lights (field section :lights)))
        (el "section" (list (attr :class "card room"))
          (list
            (el "p" (list (attr :class "kicker")) (list (txt "LIGHTS")))
            (el "h2" nil (list (txt (home/or (field room :name) "Room"))))
            (el "p" nil
              (list (txt (str (if (nil? lights) 0 (length lights)) " lights"))))
            (el "ul" (list (attr :class "lights"))
              (map 'home/light-row lights)))))))

(defun home/queue-row (item)
  (el "li" (list (attr :class (if (field item :current) "current" "")))
    (list
      (el "span" (list (attr :class "mark"))
        (list (txt (if (field item :current) "▶" "·"))))
      (el "span" nil
        (list
          (txt (str (home/or (field item :artist) "-")
                    " — "
                    (home/or (field item :title) "-"))))))))

(defun home/media-card (media)
  (if (field media :error)
      (home/error-card "Player" (field media :error))
      (let ((status (field media :status))
            (current (field media :current))
            (items (field (field media :queue) :items)))
        (el "section" (list (attr :class "card player"))
          (list
            (el "p" (list (attr :class "kicker")) (list (txt "NOW PLAYING")))
            (el "h2" nil
              (list (txt (home/or (field status :title) "Nothing playing"))))
            (el "p" nil
              (list (txt (str (home/or (field current :artist) "-")
                              " · "
                              (home/or (field current :album) "-")))))
            (el "p" nil
              (list
                (el "span" (list (attr :class "tag"))
                  (list (txt (home/state-text status))))))
            (el "ul" (list (attr :class "queue"))
              (map 'home/queue-row (take 5 items))))))))

(defun home/camera-card (camera)
  (el "section" (list (attr :class "card cameras"))
    (list
      (el "p" (list (attr :class "kicker")) (list (txt "CAMERAS")))
      (el "h2" nil (list (txt (home/or (field camera :name) "Cameras"))))
      (el "p" (list (attr :class "unavailable"))
        (list (txt (str (home/or (field camera :status) "unavailable")
                        " — "
                        (home/or (field camera :detail) "no source"))))))))

(defun home/view (snapshot)
  (list
    (el "header" nil
      (list
        (el "p" (list (attr :class "kicker")) (list (txt "HOME")))
        (el "h1" nil (list (txt "The house, on one wall.")))
        (el "p" (list (attr :class "lede"))
          (list (txt "A Soil snapshot of the working adapters: lights and the player now, cameras when the NVR path is real.")))))
    (el "div" (list (attr :class "grid"))
      (list
        (home/room-card (field snapshot :room))
        (home/media-card (field snapshot :media))
        (map 'home/camera-card (field snapshot :cameras))))))

(defun home/page (snapshot)
  (render-page "Home" (home/styles) (home/view snapshot)))
