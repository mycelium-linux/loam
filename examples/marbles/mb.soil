; SPDX-License-Identifier: MIT OR Apache-2.0
; A Soil port of the records-backed `mb` command.
;
; Reads use the host's field query; writes are ordinary record upserts, except
; claims, which compare the revision and origin they read. Entity ids are
; `<type>/<json-key>` and bodies are the Marbles JSON state.

(defun mb-fail (message)
  (eprintln (str "mb: " message))
  (exit 1))

(defun mb-options ()
  (list
    (cli-opt "json" "Machine-readable output.")
    (cli-opt-value "project" "slug" "Scope a query to one project.")
    (cli-opt-value "prefix" "prefix" "Project id prefix for create.")
    (cli-opt-value "actor" "name" "Acting identity.")))

(defun work-create-options ()
  (list
    (cli-opt-short-value "description" "d" "text" "Description.")
    (cli-opt-short-value "priority" "p" "n" "Priority (default 2).")
    (cli-opt-value "labels" "a,b" "Comma-separated labels.")
    (cli-opt-value "available-at" "epoch" "Override the creation grace.")))

(defun mb-spec ()
  (cli-spec "mb" "a small issue tracker for fleets of coding agents" "0.1.0"
    (mb-options)
    (list
      (cli-command-entry "list" "List issues, excluding closed work by default."
        (list (cli-opt "all" "Include closed issues.")
              (cli-opt-value "id" "id" "Only this issue.")
              (cli-opt-value "limit" "n" "Truncate the answer."))
        nil)
      (cli-command-entry "ready" "Open, unblocked, unclaimed, past grace." nil nil)
      (cli-command-entry "show" "Show one issue as a one-element array." nil
        (list (cli-arg "id" #t "Issue id.")))
      (cli-command-entry "history" "Show the audit trail for one issue." nil
        (list (cli-arg "id" #t "Issue id.")))
      (cli-command-entry "create" "Create an issue."
        (list (cli-opt-short-value "description" "d" "text" "Description.")
              (cli-opt-short-value "priority" "p" "n" "Priority (default 2).")
              (cli-opt-short-value "type" "t" "type" "Issue type (default task).")
              (cli-opt-value "parent" "id" "Parent issue.")
              (cli-opt-value "label" "label" "Initial label.")
              (cli-opt-value "labels" "a,b" "Comma-separated labels.")
              (cli-opt-value "id" "id" "Explicit issue id.")
              (cli-opt-value "metadata" "json" "Metadata object text.")
              (cli-opt-value "external-ref" "ref" "External reference.")
              (cli-opt-value "available-at" "epoch" "Override the creation grace."))
        (list (cli-arg "title" #t "Issue title.")))
      (cli-command-entry "update" "Update issue fields."
        (list (cli-opt-value "title" "text" "New title.")
              (cli-opt-value "description" "text" "New description.")
              (cli-opt-value "notes" "text" "Append to the description.")
              (cli-opt-value "status" "status" "New status.")
              (cli-opt-value "priority" "n" "New priority.")
              (cli-opt-value "metadata" "json" "Metadata object to merge.")
              (cli-opt-value "set-metadata" "key=value" "Set one metadata key.")
              (cli-opt-value "assignee" "name" "Claim for this actor."))
        (list (cli-arg "id" #t "Issue id.")))
      (cli-command-entry "claim" "Take a lease on an issue."
        (list (cli-opt-value "as" "name" "Claim holder.")
              (cli-opt-value "ttl" "seconds" "Lease seconds.")
              (cli-opt "human" "Use the human (business-hours) lease."))
        (list (cli-arg "id" #t "Issue id.")))
      (cli-command-entry "touch" "Renew a claim without moving work."
        (list (cli-opt-value "as" "name" "Claim holder."))
        (list (cli-arg "id" #t "Issue id.")))
      (cli-command-entry "release" "Drop a claim."
        (list (cli-opt-value "as" "name" "Claim holder."))
        (list (cli-arg "id" #t "Issue id.")))
      (cli-command-entry "review" "Move work to review; record the PR or commit."
        (list (cli-opt-value "pr" "url" "Pull request URL.")
              (cli-opt-value "commit" "sha" "Commit sha."))
        (list (cli-arg "id" #t "Issue id.")))
      (cli-command-entry "close" "Close with delivery evidence."
        (list (cli-opt-value "reason" "text" "Close reason.")
              (cli-opt-value "pr" "url" "Merged pull request URL.")
              (cli-opt-value "commit" "sha" "Merge commit sha.")
              (cli-opt-value "ack" "text" "No delivery expected because ..."))
        (list (cli-arg "id" #t "Issue id.")))
      (cli-command-group "dep" "Manage dependency edges." nil
        (list
          (cli-command-entry "add" "Make CHILD wait for PARENT." nil
            (list (cli-arg "child" #t "Blocked issue.") (cli-arg "parent" #t "Blocker.")))
          (cli-command-entry "rm" "Remove a dependency edge." nil
            (list (cli-arg "child" #t "Blocked issue.") (cli-arg "parent" #t "Blocker.")))))
      (cli-command-group "label" "Manage labels." nil
        (list
          (cli-command-entry "add" "Add a label." nil
            (list (cli-arg "id" #t "Issue id.") (cli-arg "label" #t "Label.")))
          (cli-command-entry "rm" "Remove a label." nil
            (list (cli-arg "id" #t "Issue id.") (cli-arg "label" #t "Label.")))))
      (cli-command-entry "stats" "Issue counts by project and status." nil nil)
      (cli-command-entry "supersede" "Close an issue and point at its replacement."
        (list (cli-opt-value "with" "id" "Replacement issue."))
        (list (cli-arg "id" #t "Issue id.")))
      (cli-command-entry "sweep" "Requeue expired agent claims, escalate human ones." nil nil)
      (cli-command-entry "projects" "List projects in the store." nil nil)
      (cli-command-entry "doctor" "Check issue/project/dependency integrity." nil nil)
      (cli-command-group "project" "Administer the store." nil
        (list (cli-command-entry "rm" "Remove a project and its issues." nil
                (list (cli-arg "slug" #t "Project slug.")))))
      (cli-command-group "goal" "Goals are project roots." nil
        (list
          (cli-command-entry "create" "Create a goal."
            (work-create-options)
            (list (cli-arg "title" #t "Goal title.")))
          (cli-command-entry "list" "List goals."
            (list (cli-opt "all" "Include closed goals.")) nil)
          (cli-command-entry "show" "Show a goal and its progress." nil
            (list (cli-arg "id" #t "Goal id.")))))
      (cli-command-group "epic" "Epics belong to a goal." nil
        (list
          (cli-command-entry "create" "Create an epic."
            (cons (cli-opt-value "goal" "id" "Parent goal.")
                  (work-create-options))
            (list (cli-arg "title" #t "Epic title.")))))
      (cli-command-group "task" "Tasks belong to an epic." nil
        (list
          (cli-command-entry "create" "Create a task."
            (cons (cli-opt-value "epic" "id" "Parent epic.")
                  (work-create-options))
            (list (cli-arg "title" #t "Task title.")))))
      (cli-command-group "folder" "Group projects into folders." nil
        (list
          (cli-command-entry "create" "Create a folder."
            (list (cli-opt-value "slug" "slug" "Explicit slug.")
                  (cli-opt-value "parent" "slug" "Parent folder."))
            (list (cli-arg "name" #t "Folder name.")))
          (cli-command-entry "list" "List folders and project assignments." nil nil)
          (cli-command-entry "tree" "List folders and project assignments." nil nil)
          (cli-command-entry "move" "File a project into a folder." nil
            (list (cli-arg "project" #t "Project slug.")
                  (cli-arg "folder" #t "Folder slug, or none.")))))
      (cli-command-entry "burndown" "Daily remaining-work series."
        (list (cli-opt-value "goal" "id" "Scope to a goal.")
              (cli-opt-value "epic" "id" "Scope to an epic.")
              (cli-opt-value "days" "n" "Window in days (default 30)."))
        nil)
      (cli-command-entry "portfolio" "Folder/project/goal rollups."
        (list (cli-opt-value "folder" "slug" "Only this folder.")
              (cli-opt-value "days" "n" "Burn window (default 14).")
              (cli-opt-value "stale-days" "n" "Stale cutoff (default 7)."))
        nil)
      (cli-command-group "plan" "Plans are DAG views over issues." nil
        (list
          (cli-command-entry "show" "Show a plan." nil
            (list (cli-arg "plan" #t "Plan name.")))
          (cli-command-entry "gantt" "Gantt view of a plan." nil
            (list (cli-arg "plan" #t "Plan name.")))
          (cli-command-entry "ready" "Ready nodes in a plan." nil
            (list (cli-arg "plan" #t "Plan name.")))
          (cli-command-entry "create" "Create issues from a JSON plan spec."
            (list (cli-opt-value "plan" "name" "Plan name.")
                  (cli-opt-value "project" "slug" "Project slug.")
                  (cli-opt "dry-run" "Validate without writing."))
            (list (cli-arg "spec" #t "Inline JSON plan spec."))))))))

; ---------------------------------------------------------------------------
; Records access
; ---------------------------------------------------------------------------

(defun json-object-empty? (value)
  (and (not (nil? value))
       (= (length value) 1)
       (= (first value) '__json_object__)))

(defun entity (type key)
  (str type "/[\"" key "\"]"))

(defun entity2 (type a b)
  (str type "/[\"" a "\",\"" b "\"]"))

(defun entry-of (id)
  (let ((result (soil:records/get (record-key "" id))))
    (if (ok? result) (value result) nil)))

(defun body-of (id)
  (let ((entry (entry-of id)))
    (if (nil? entry) nil (entry-body entry))))

(defun field-prefix (field)
  (cond
    ((= field "project") "issue/")
    ((= field "child") "dependency/")
    ((= field "parent") "dependency/")
    ((= field "slug") "project/")
    ((= field "issue_id") "marbles_event/")
    (else "")))

(defun query-entries-prefix (prefix field value)
  (let ((result (records/where prefix field value)))
    (if (ok? result)
        (let ((entries (field (value result) :entries)))
          (if (or (nil? entries) (= 0 (length entries))) nil entries))
        (mb-fail (str "records query failed: " (field result :err))))))

(defun query-entries (field value)
  (query-entries-prefix (field-prefix field) field value))

(defun typed-bodies (prefix field value)
  (map 'entry-body (filter-with 'entry-type? prefix (query-entries-prefix prefix field value))))

(defun entry-type? (entry prefix)
  (cli-prefix? (entry-id entry) prefix))

(defun scan-into (cursor acc)
  (let ((result (soil:records/scan "" cursor 512)))
    (if (not (ok? result))
        (mb-fail (str "records scan failed: " (field result :err)))
        (let ((page (value result)))
          (let ((entries (field page :entries)))
            (let ((next (field page :next)))
              (let ((acc (reverse-into entries acc)))
                (if (nil? next) acc (scan-into next acc)))))))))

(defun all-entry-bodies (prefix)
  (map 'entry-body
    (filter-with 'entry-type? prefix (reverse (scan-into nil nil)))))

(defun field-bodies (prefix fields)
  (let ((result (records/select prefix fields)))
    (if (not (ok? result))
        (mb-fail (str "records projection failed: " (field result :err)))
        (map 'entry-body (field (value result) :entries)))))

(defun all-issue-bodies ()
  (if (nil? (project-summaries))
      nil
      (all-issue-bodies-for (project-summaries))))

(defun all-issue-bodies-for (projects)
  (if (nil? projects) nil
      (append
        (typed-bodies "issue/" "project" (field (first projects) :slug))
        (all-issue-bodies-for (rest projects)))))

(defun issue-body (id)
  (let ((body (body-of (entity "issue" id))))
    (if (nil? body) (mb-fail (str "issue not found: " id)) body)))

(defun project-body (slug)
  (body-of (entity "project" slug)))

(defun project-prefix (slug result)
  (let ((body (project-body slug)))
    (if (and (not (nil? body)) (not (nil? (field body :prefix))))
        (field body :prefix)
        (let ((prefix (cli-result-option result "prefix")))
          (if (nil? prefix) slug prefix)))))

(defun ensure-project (slug prefix now)
  (let ((body (project-body slug)))
    (let ((body (if (nil? body)
                    (list (list :slug slug) (list :prefix prefix) (list :root "")
                          (list :created_at now))
                    body)))
      (upsert-record "" (entity "project" slug) "marbles.project@1" body now))))

(defun issue-in-project? (issue project)
  (or (nil? project) (= (field issue :project) project)))

(defun issue-bodies-for (project)
  (if (nil? project)
      (all-issue-bodies)
      (typed-bodies "issue/" "project" project)))

; ---------------------------------------------------------------------------
; Read queries
; ---------------------------------------------------------------------------

(defun dependency-edges (field value)
  (typed-bodies "dependency/" field value))

(defun find-body (id issues)
  (cond
    ((nil? issues) nil)
    ((= (field (first issues) :id) id) (first issues))
    (else (find-body id (rest issues)))))

(defun issue-closed? (issue)
  (= (field issue :status) "closed"))

(defun parent-open? (parent)
  (let ((issue (body-of (entity "issue" parent))))
    (and (not (nil? issue)) (not (issue-closed? issue)))))

(defun edge-parent-open? (edge)
  (parent-open? (field edge :parent)))

(defun edge-child-open? (edge)
  (parent-open? (field edge :child)))

(defun dependency-count (id)
  (let ((edges (dependency-edges "child" id)))
    (if (nil? edges) 0
        (let ((open (filter 'edge-parent-open? edges)))
          (if (nil? open) 0 (length open))))))

(defun dependent-count (id)
  (let ((edges (dependency-edges "parent" id)))
    (if (nil? edges) 0
        (let ((open (filter 'edge-child-open? edges)))
          (if (nil? open) 0 (length open))))))

(defun issue-with-counts (issue)
  (let ((id (field issue :id)))
    (assoc :dependent_count (dependent-count id)
      (assoc :dependency_count (dependency-count id) issue))))

(defun issues-with-counts (issues)
  (map 'issue-with-counts issues))

(defun or-empty (xs)
  (if (nil? xs) (list) xs))

(defun project-filter (result)
  (let ((project (cli-result-option result "project")))
    (if (nil? project) (getenv "MARBLES_PROJECT") project)))

(defun limit-option (result)
  (let ((limit (cli-result-option result "limit")))
    (if (nil? limit) 0 (json-decode limit))))

(defun truncate (limit issues)
  (if (or (<= limit 0) (nil? issues)) issues (take limit issues)))

(defun issue-id-option? (issue id)
  (or (nil? id) (= (field issue :id) id)))

(defun open-issue? (issue)
  (not (issue-closed? issue)))

(defun list-project (project id all limit)
  (let ((issues (issues-with-counts (issue-bodies-for project))))
    (let ((visible (filter-with 'issue-id-option? id issues)))
      (truncate limit (if all visible (filter 'open-issue? visible))))))

(defun issue-available? (issue now)
  (let ((available (field issue :available_at)))
    (or (nil? available) (<= available now))))

(defun issue-claimed? (issue now)
  (let ((assignee (field issue :assignee))
        (expires (field issue :expires_at)))
    (and (not (nil? assignee)) (or (nil? expires) (> expires now)))))

(defun ready-issue? (issue now)
  (and (= (field issue :status) "open")
       (= (dependency-count (field issue :id)) 0)
       (issue-available? issue now)
       (not (issue-claimed? issue now))))

(defun ready-project (project)
  (let ((now (now-seconds)))
    (issues-with-counts
      (filter-with 'ready-issue? now (issue-bodies-for project)))))

; ---------------------------------------------------------------------------
; Writes
; ---------------------------------------------------------------------------

(defun entry-version (entry)
  (list (list :revision (field entry :revision))
        (list :origin (field entry :origin))))

(defun save-issue (body now)
  (upsert-record "" (entity "issue" (field body :id)) "marbles.issue@1" body now)
  body)

(defun event-id (seq)
  (entity "marbles_event" (str seq)))

(defun next-event-seq (seq)
  (if (nil? (body-of (event-id seq))) seq (next-event-seq (+ seq 1))))

(defun log-event (id ts actor event detail)
  (let ((seq (next-event-seq (now-ms))))
    (upsert-record "" (event-id seq) "marbles.marbles_event@1"
      (list (list :issue_id id) (list :ts ts) (list :actor actor)
            (list :event event) (list :detail detail))
      ts)
    (if (= event "heartbeat") nil
        (let ((project (field (body-of (entity "issue" id)) :project)))
          (if (nil? project) nil
              (upsert-record "" (entity "outbound_event" (str seq)) "marbles.outbound_event@1"
                (list (list :seq seq) (list :store_id (store-id)) (list :issue_id id)
                      (list :project project) (list :occurred_at ts)
                      (list :event event) (list :next_attempt_at ts)
                      (list :delivered_at nil) (list :attempts 0)
                      (list :last_error nil))
                ts))))))

(defun actor-name (result)
  (let ((actor (cli-result-option result "actor")))
    (if (not (nil? actor)) actor
        (let ((env (getenv "MARBLES_ACTOR")))
          (if (nil? env) "agent" env)))))

(defun option-int (result name)
  (let ((value (cli-result-option result name)))
    (if (nil? value) nil (json-decode value))))

(defun now-seconds ()
  (int (/ (now-ms) 1000)))

(defun short-suffix (now)
  (let ((chars (string-chars (str now))))
    (string-join (drop (- (length chars) 4) chars) "")))

(defun candidate-id (prefix now attempt)
  (let ((id (str prefix "-" (short-suffix (+ now attempt)))))
    (if (nil? (body-of (entity "issue" id))) id
        (candidate-id prefix now (+ attempt 1)))))

(defun split-comma-into (chars current out)
  (cond
    ((nil? chars) (reverse (cons (string-join (reverse current) "") out)))
    ((= (first chars) ",")
      (split-comma-into (rest chars) nil
        (cons (string-join (reverse current) "") out)))
    (else (split-comma-into (rest chars) (cons (first chars) current) out))))

(defun split-csv (text)
  (if (= text "") nil (split-comma-into (string-chars text) nil nil)))

(defun with-external-ref (metadata external)
  (if (nil? external) metadata
      (assoc (keyword "external_ref") external
        (if (json-object-empty? metadata) (list) metadata))))

(defun new-issue-body (id project title description issue-type priority labels parent available now metadata external)
  (list
    (list :id id) (list :project project) (list :title title)
    (list :description description) (list :status "open")
    (list :priority (if (= priority 0) 2 priority))
    (list :issue_type issue-type)
    (list :labels (or-empty labels))
    (list :parent parent) (list :assignee nil)
    (list :actor_kind nil) (list :expires_at nil)
    (list :available_at (if (nil? available) (+ now 600) available))
    (list :created_at now) (list :updated_at now) (list :closed_at nil)
    (list :metadata metadata) (list :external_ref external)
    (list :evidence (list))))

(defun create-issue (result actor now)
  (let ((project (project-filter result)))
    (if (nil? project) (mb-fail "create needs --project or MARBLES_PROJECT"))
    (let ((prefix (project-prefix project result)))
      (ensure-project project prefix now)
      (let ((explicit (cli-result-option result "id")))
        (if (and (not (nil? explicit)) (not (nil? (body-of (entity "issue" explicit)))))
            (mb-fail (str "issue id " explicit " already exists")))
        (let ((id (if (nil? explicit) (candidate-id prefix now 0) explicit)))
          (let ((title (first (cli-result-args result)))
                (description (or (cli-result-option result "description") ""))
                (priority (or (option-int result "priority") 2))
                (issue-type (or (cli-result-option result "type") "task"))
                (label (cli-result-option result "label"))
                (labels (cli-result-option result "labels"))
                (parent (cli-result-option result "parent"))
                (external (cli-result-option result "external-ref"))
                (available (option-int result "available-at"))
                (metadata (cli-result-option result "metadata")))
            (let ((labels (append (if (nil? label) nil (list label))
                                  (if (nil? labels) nil (split-csv labels)))))
              (let ((metadata (with-external-ref
                                (if (nil? metadata) (json-object) (json-decode metadata))
                                external)))
                (let ((body (new-issue-body id project title description issue-type
                              priority labels parent available now metadata external)))
                  (save-issue body now)
                  (log-event id now actor "created" title)
                  (list (list :id id)))))))))))

(defun work-labels (result)
  (let ((labels (cli-result-option result "labels")))
    (if (nil? labels) nil (split-csv labels))))

(defun create-work (result project issue-type parent actor now)
  (let ((prefix (project-prefix project result)))
    (ensure-project project prefix now)
    (let ((id (candidate-id prefix now 0))
          (title (first (cli-result-args result)))
          (description (or (cli-result-option result "description") ""))
          (priority (or (option-int result "priority") 2))
          (available (option-int result "available-at")))
      (let ((body (new-issue-body id project title description issue-type priority
                    (work-labels result) parent available now (json-object) nil)))
        (save-issue body now)
        (log-event id now actor "created" title)
        (list (list :id id))))))

(defun record-without (record key)
  (cond
    ((nil? record) nil)
    ((= (first (first record)) key) (rest record))
    (else (cons (first record) (record-without (rest record) key)))))

(defun merge-metadata (base incoming)
  (if (nil? incoming) base
      (let ((pair (first incoming)))
        (let ((key (first pair)) (value (nth 1 pair)))
          (let ((base (if (nil? value)
                          (record-without base key)
                          (assoc key value base))))
            (merge-metadata base (rest incoming)))))))

(defun metadata-option (result)
  (let ((text (cli-result-option result "metadata"))
        (pair (cli-result-option result "set-metadata")))
    (if (and (nil? text) (nil? pair)) nil
    (let ((base (if (nil? text) (list) (json-decode text))))
      (let ((base (if (json-object-empty? base) (list) base)))
        (if (nil? pair) base
            (let ((split (cli-split-equals pair)))
              (assoc (keyword (first split)) (nth 1 split) base))))))))

(defun status-valid? (status)
  (or (= status "open") (= status "in_progress") (= status "review")
      (= status "blocked") (= status "deferred") (= status "closed")))

(defun update-issue (result actor now)
  (let ((id (first (cli-result-args result))))
    (let ((body (issue-body id)))
      (let ((title (cli-result-option result "title"))
            (description (cli-result-option result "description"))
            (notes (cli-result-option result "notes"))
            (status (cli-result-option result "status"))
            (priority (option-int result "priority"))
            (metadata (metadata-option result)))
        (if (and (not (nil? status)) (not (status-valid? status)))
            (mb-fail (str "bad status: " status)))
        (let ((body (if (nil? metadata) body
                        (assoc :metadata
                          (merge-metadata
                            (if (json-object-empty? (field body :metadata))
                                (list) (field body :metadata))
                            metadata)
                          body))))
        (let ((body (if (nil? title) body (assoc :title title body))))
          (let ((body (if (nil? description) body (assoc :description description body))))
            (let ((body (if (nil? notes) body
                            (assoc :description
                              (if (= (field body :description) "") notes
                                  (str (field body :description) "\n" notes))
                              body))))
              (let ((body (if (nil? priority) body (assoc :priority priority body))))
                (let ((body (if (nil? status) body
                                (assoc :closed_at (if (= status "closed") now nil)
                                  (assoc :status status body)))))
                  (let ((body (assoc :available_at (max (+ now 120) (or (field body :available_at) 0))
                                  (assoc :updated_at now body))))
                    (save-issue body now)
                    (log-event id now actor "updated" "")
                    (let ((assignee (cli-result-option result "assignee")))
                      (if (nil? assignee) body (claim-issue id assignee "agent" nil actor now))))))))))))))

(defun claim-issue (id assignee kind ttl actor now)
  (let ((entry (entry-of (entity "issue" id))))
    (if (nil? entry) (mb-fail (str "issue not found: " id)))
    (let ((body (entry-body entry)))
      (let ((held (and (not (nil? (field body :assignee)))
                       (field body :expires_at)
                       (> (field body :expires_at) now))))
        (if (and held (not (= (field body :assignee) assignee)))
            (mb-fail (str id " is claimed by " (field body :assignee))))
        (let ((ttl (if (nil? ttl)
                       (if (= kind "human") 172800 1800)
                       ttl)))
          (let ((body (assoc :actor_kind kind
                        (assoc :expires_at (+ now ttl)
                          (assoc :updated_at now
                            (assoc :assignee assignee body))))))
            (let ((cas (soil:records/compare-and-swap
                         (field entry :key) (entry-version entry)
                         (make-entry "" (entity "issue" id) "marbles.issue@1" body now))))
              (if (not (ok? cas)) (mb-fail (str "claim failed: " (field cas :err))))
              (let ((applied (field (value cas) :applied)))
                (if (not applied)
                    (mb-fail (str "claim for " id " lost a race; retry"))
                    (begin
                      (log-event id now assignee "claimed" kind)
                      (list (list :id id) (list :assignee assignee)
                            (list :actor_kind kind) (list :expires_at (+ now ttl)))))))))))))

(defun claim-command (result actor now)
  (let ((id (first (cli-result-args result)))
        (assignee (or (cli-result-option result "as") actor))
        (kind (if (cli-result-option result "human") "human" "agent"))
        (ttl (option-int result "ttl")))
    (claim-issue id assignee kind ttl actor now)))

(defun touch-issue (result actor now)
  (let ((id (first (cli-result-args result)))
        (holder (or (cli-result-option result "as") actor)))
    (let ((entry (entry-of (entity "issue" id))))
      (if (nil? entry) (mb-fail (str "issue not found: " id)))
      (let ((body (entry-body entry)))
        (if (not (= (field body :assignee) holder))
            (mb-fail (str id " is not claimed by " holder)))
        (let ((ttl (if (= (field body :actor_kind) "human") 172800 1800)))
          (let ((body (assoc :expires_at (+ now ttl)
                        (assoc :updated_at now body))))
            (let ((cas (soil:records/compare-and-swap
                         (field entry :key) (entry-version entry)
                         (make-entry "" (entity "issue" id) "marbles.issue@1" body now))))
              (if (not (and (ok? cas) (field (value cas) :applied)))
                  (mb-fail "touch lost a race; retry"))
              (log-event id now holder "heartbeat" "")
              (list (list :expires_at (+ now ttl))))))))))

(defun release-issue (result actor now)
  (let ((id (first (cli-result-args result)))
        (holder (or (cli-result-option result "as") actor)))
    (let ((body (issue-body id)))
      (let ((body (assoc :expires_at nil
                    (assoc :actor_kind nil
                      (assoc :assignee nil
                        (assoc :updated_at now body))))))
        (save-issue body now)
        (log-event id now holder "released" "")
        (list (list :released id))))))

(defun evidence-entry (kind value)
  (list (list :kind kind) (list :value value)))

(defun evidence-kind? (entry kind)
  (= (field entry :kind) kind))

(defun evidence-set (evidence kind value)
  (cons (evidence-entry kind value)
        (filter-with 'evidence-kind? kind evidence)))

(defun evidence-has? (evidence kind value)
  (if (nil? evidence) #f
      (if (and (= (field (first evidence) :kind) kind)
               (= (field (first evidence) :value) value))
          #t
          (evidence-has? (rest evidence) kind value))))

(defun evidence-add (evidence kind value)
  (if (evidence-has? evidence kind value) evidence
      (append evidence (list (evidence-entry kind value)))))

(defun review-issue (result actor now)
  (let ((id (first (cli-result-args result)))
        (pr (cli-result-option result "pr"))
        (commit (cli-result-option result "commit")))
    (let ((body (issue-body id)))
      (let ((evidence (or (field body :evidence) nil)))
        (let ((evidence (if (nil? pr) evidence (evidence-set evidence "pr" pr))))
          (let ((evidence (if (nil? commit) evidence (evidence-set evidence "commit" commit))))
            (let ((body (assoc-all body
                          (list (list :evidence evidence)
                                (list :status "review")
                                (list :available_at (max (+ now 120) (or (field body :available_at) 0)))
                                (list :updated_at now)))))
              (save-issue body now)
              (log-event id now actor "status" "review")
              body)))))))

(defun close-issue (result actor now)
  (let ((id (first (cli-result-args result)))
        (reason (cli-result-option result "reason"))
        (pr (cli-result-option result "pr"))
        (commit (cli-result-option result "commit"))
        (ack (cli-result-option result "ack")))
    (if (and (nil? pr) (nil? commit) (nil? ack))
        (mb-fail "close needs --pr, --commit, or --ack"))
    (if (> (dependency-count id) 0)
        (mb-fail (str id " still waits on an open dependency")))
    (let ((body (issue-body id)))
      (let ((evidence (or (field body :evidence) nil)))
        (let ((evidence (if (nil? pr) evidence (evidence-add evidence "pr" pr))))
          (let ((evidence (if (nil? commit) evidence (evidence-add evidence "commit" commit))))
            (let ((evidence (if (nil? ack) evidence (evidence-add evidence "ack" ack))))
              (let ((body (assoc-all body
                            (list (list :evidence evidence)
                                  (list :closed_at now)
                                  (list :expires_at nil)
                                  (list :actor_kind nil)
                                  (list :assignee nil)
                                  (list :status "closed")
                                  (list :updated_at now)))))
                (save-issue body now)
                (log-event id now actor "closed" (or reason ""))
                body))))))))

(defun dep-add (result actor now)
  (let ((child (first (cli-result-args result)))
        (parent (nth 1 (cli-result-args result))))
    (issue-body child)
    (issue-body parent)
    (if (= child parent) (mb-fail "an issue cannot depend on itself"))
    (upsert-record "" (entity2 "dependency" child parent) "marbles.dependency@1"
      (list (list :child child) (list :parent parent)) now)
    (log-event child now actor "depends_on" parent)
    (list (list :child child) (list :parent parent) (list :present #t))))

(defun dep-rm (result actor now)
  (let ((child (first (cli-result-args result)))
        (parent (nth 1 (cli-result-args result))))
    (let ((delete (soil:records/delete (record-key "" (entity2 "dependency" child parent)))))
      (log-event child now actor "unblocked_from" parent)
      (list (list :child child) (list :parent parent) (list :present #f)))))

(defun label-has? (label labels)
  (if (nil? labels) #f
      (if (= (first labels) label) #t (label-has? label (rest labels)))))

(defun label-not? (entry label)
  (not (= entry label)))

(defun label-add (result actor now)
  (let ((id (first (cli-result-args result)))
        (label (nth 1 (cli-result-args result))))
    (let ((body (issue-body id)))
      (let ((labels (if (label-has? label (field body :labels))
                        (field body :labels)
                        (append (field body :labels) (list label)))))
        (let ((body (assoc :labels labels (assoc :updated_at now body))))
          (save-issue body now)
          (log-event id now actor "labels" label)
          (list (list :id id) (list :label label) (list :present #t)))))))

(defun label-rm (result actor now)
  (let ((id (first (cli-result-args result)))
        (label (nth 1 (cli-result-args result))))
    (let ((body (issue-body id)))
      (let ((labels (or-empty (filter-with 'label-not? label (field body :labels)))))
        (let ((body (assoc :labels labels (assoc :updated_at now body))))
          (save-issue body now)
          (log-event id now actor "labels" label)
          (list (list :id id) (list :label label) (list :present #f)))))))

(defun insert-event (event events)
  (if (nil? events) (list event)
      (if (<= (field event :ts) (field (first events) :ts))
          (cons event events)
          (cons (first events) (insert-event event (rest events))))))

(defun sort-events (events)
  (if (nil? events) nil
      (insert-event (first events) (sort-events (rest events)))))

(defun history-issue (id)
  (sort-events (typed-bodies "marbles_event/" "issue_id" id)))

(defun stats-project (issue stats)
  (let ((project (field issue :project))
        (status (field issue :status)))
    (let ((stats (if (nil? stats) (list) stats)))
      (let ((entry (field stats (keyword project))))
        (let ((entry (if (nil? entry)
                         (list (list :by_status (list (list (keyword status) 1)))
                               (list :total 1))
                         (let ((by (field entry :by_status)))
                           (list
                             (list :by_status
                                   (assoc (keyword status)
                                     (+ (or (field by status) 0) 1)
                                     by))
                             (list :total (+ (or (field entry :total) 0) 1)))))))
          (if (nil? (field stats (keyword project)))
              (list (list (keyword project) entry))
              (assoc (keyword project) entry stats)))))))

(defun stats-all (issues stats)
  (if (nil? issues) stats
      (stats-all (rest issues) (stats-project (first issues) stats))))

(defun stats-add-group (row stats)
  (let ((values (field row :values))
        (count (field row :count)))
    (let ((project (nth 0 values))
          (status (nth 1 values)))
      (let ((entry (field stats (keyword project)))
            (stats (if (nil? stats) (list) stats)))
        (let ((entry
                (if (nil? entry)
                    (list (list :by_status (list (list (keyword status) count)))
                          (list :total count))
                    (let ((by (field entry :by_status)))
                      (list
                        (list :by_status
                          (assoc (keyword status)
                            (+ (or (field by status) 0) count)
                            by))
                        (list :total (+ (or (field entry :total) 0) count)))))))
          (assoc (keyword project) entry stats))))))

(defun stats-add-groups (rows stats)
  (if (nil? rows) stats
      (stats-add-groups (rest rows) (stats-add-group (first rows) stats))))

(defun stats-command ()
  (let ((result (records/aggregate "" "issue/" nil (list "project" "status") "" 0)))
    (if (not (ok? result))
        (mb-fail (str "aggregate failed: " (field result :err)))
        (let ((stats (stats-add-groups (value result) nil)))
          (if (nil? stats) (json-object) stats)))))

; ---------------------------------------------------------------------------
; Admin, supersession, and sweeps
; ---------------------------------------------------------------------------

(defun label-set (labels label)
  (if (label-has? label labels) labels (append (or-empty labels) (list label))))

(defun supersede-issue (result actor now)
  (let ((id (first (cli-result-args result)))
        (with (cli-result-option result "with")))
    (if (nil? with) (mb-fail "supersede needs --with ID"))
    (issue-body with)
    (let ((body (issue-body id)))
      (let ((body (assoc-all body
                    (list
                      (list :evidence
                        (evidence-add (or (field body :evidence) (list))
                          "ack" (str "superseded by " with)))
                      (list :labels (label-set (field body :labels) (str "supersedes:" with)))
                      (list :status "closed")
                      (list :closed_at now)
                      (list :expires_at nil)
                      (list :actor_kind nil)
                      (list :assignee nil)
                      (list :updated_at now)))))
        (save-issue body now)
        (log-event id now actor "closed" (str "superseded by " with))
        (log-event id now actor "labels" (str "supersedes:" with))
        (list (list :superseded id) (list :by with))))))

(defun expired-claim? (issue now)
  (and (not (nil? (field issue :assignee)))
       (not (nil? (field issue :expires_at)))
       (<= (field issue :expires_at) now)))

(defun sweep-one (issue report now)
  (if (not (expired-claim? issue now))
      report
      (let ((id (field issue :id))
            (assignee (field issue :assignee)))
        (if (= (field issue :actor_kind) "human")
            (begin
              (log-event id now "sweeper" "escalated" assignee)
              (assoc-all report
                (list (list :escalated
                        (append (or-empty (field report :escalated))
                                (list (str id " (" assignee ")")))))))
            (let ((body (assoc-all issue
                          (list (list :assignee nil)
                                (list :actor_kind nil)
                                (list :expires_at nil)
                                (list :updated_at now)))))
              (save-issue body now)
              (log-event id now "sweeper" "claim_expired" assignee)
              (assoc-all report
                (list (list :requeued
                        (append (or-empty (field report :requeued)) (list id))))))))))

(defun sweep-all (issues report now)
  (if (nil? issues) report
      (sweep-all (rest issues) (sweep-one (first issues) report now) now)))

(defun sweep-command (now)
  (sweep-all (all-issue-bodies)
    (list (list :requeued (list)) (list :escalated (list)))
    now))

(defun project-folder-of (slug)
  (let ((rows (typed-bodies "project_folder/" "project" slug)))
    (if (nil? rows) nil (field (first rows) :folder))))

(defun project-summary (body)
  (list (list :slug (field body :slug))
        (list :root (field body :root))
        (list :prefix (field body :prefix))
        (list :folder (project-folder-of (field body :slug)))))

(defun project-summaries ()
  (map 'project-summary (all-entry-bodies "project/")))

(defun doctor-issues (issues projects problems deps)
  (if (nil? issues)
      (list problems deps)
      (let ((issue (first issues)))
        (let ((id (field issue :id))
              (project (field issue :project)))
          (let ((problems (if (nil? (field projects (keyword project)))
                              (append problems
                                (list (str "issue " id " names missing project " project)))
                              problems)))
            (let ((edges (filter-with 'edge-child? id (field-bodies "dependency/" (list "child" "parent")))))
              (let ((problems
                      (if (nil? edges) problems
                          (doctor-edges id edges problems))))
                (doctor-issues (rest issues) projects problems
                  (+ deps (if (nil? edges) 0 (length edges)))))))))))

(defun edge-child? (edge child)
  (= (field edge :child) child))

(defun doctor-edges (id edges problems)
  (if (nil? edges) problems
      (let ((parent (field (first edges) :parent)))
        (doctor-edges id (rest edges)
          (if (nil? (body-of (entity "issue" parent)))
              (append problems (list (str "issue " id " depends on missing " parent)))
              problems)))))

(defun doctor-projects (projects ids problems)
  (if (nil? projects) problems
      (doctor-projects (rest projects) ids
        (if (nil? (field ids (field (first projects) :slug)))
            (append problems
              (list (str "project " (field (first projects) :slug) " has no issues")))
            problems))))

(defun store-id ()
  (let ((rows (all-entry-bodies "store_meta/")))
    (if (nil? rows) nil (field (first rows) :value))))

(defun doctor-command ()
  (let ((issues (field-bodies "issue/" (list "id" "project")))
        (projects (project-summaries)))
    (let ((project-map (project-map-of projects)))
      (let ((checked (doctor-issues issues project-map nil 0)))
        (let ((problems (first checked))
              (deps (nth 1 checked)))
          (list
            (list :backend "soil:records")
            (list :store_id (store-id))
            (list :integrity (if (nil? problems) "ok" "problems"))
            (list :quick_check (if (nil? problems) "ok" "failed"))
            (list :projects (length (or-empty projects)))
            (list :issues (length (or-empty issues)))
            (list :dependencies deps)
            (list :folders (length (or-empty (all-entry-bodies "folder/"))))
            (list :problems (or-empty problems))))))))

(defun project-map-of (projects)
  (if (nil? projects) nil
      (assoc (keyword (field (first projects) :slug)) (first projects)
        (project-map-of (rest projects)))))

; ---------------------------------------------------------------------------
; Goals, epics, tasks
; ---------------------------------------------------------------------------

(defun status-is? (issue status)
  (= (field issue :status) status))

(defun type-issue? (issue kind)
  (= (field issue :issue_type) kind))

(defun task-issue? (issue)
  (let ((kind (field issue :issue_type)))
    (not (or (= kind "goal") (= kind "epic")))))

(defun status-count (status issues)
  (length (or-empty (filter-with 'status-is? status issues))))

(defun kind-count (kind issues)
  (length (or-empty (filter-with 'type-issue? kind issues))))

(defun progress-of (issues)
  (let ((total (length (or-empty issues)))
        (closed (status-count "closed" issues)))
    (list
      (list :total total)
      (list :open (status-count "open" issues))
      (list :in_progress (status-count "in_progress" issues))
      (list :review (status-count "review" issues))
      (list :blocked (status-count "blocked" issues))
      (list :deferred (status-count "deferred" issues))
      (list :closed closed)
      (list :epics (kind-count "epic" issues))
      (list :tasks (length (or-empty (filter 'task-issue? issues))))
      (list :percent_done
        (if (= total 0) 0.0 (/ (round (* 1000.0 (/ closed total))) 10.0))))))

(defun member? (item items)
  (cond ((nil? items) #f)
        ((= item (first items)) #t)
        (else (member? item (rest items)))))

(defun children-of (parent issues)
  (filter-with 'child-of? parent issues))

(defun child-of? (issue parent)
  (= (field issue :parent) parent))

(defun descendant-ids (root issues)
  (let ((kids (children-of root issues)))
    (if (nil? kids) nil
        (append (issue-ids kids) (descendant-ids-each kids issues)))))

(defun issue-ids (issues)
  (if (nil? issues) nil (cons (field (first issues) :id) (issue-ids (rest issues)))))

(defun descendant-ids-each (kids issues)
  (if (nil? kids) nil
      (append (descendant-ids (field (first kids) :id) issues)
              (descendant-ids-each (rest kids) issues))))

(defun progress-for (issues root)
  (let ((ids (descendant-ids root issues)))
    (progress-of
      (filter-with 'issue-in-ids? ids issues))))

(defun issue-in-ids? (issue ids)
  (member? (field issue :id) ids))

(defun goal-summary (goal issues)
  (list
    (list :id (field goal :id))
    (list :title (field goal :title))
    (list :status (field goal :status))
    (list :priority (field goal :priority))
    (list :project (field goal :project))
    (list :progress (progress-for issues (field goal :id)))))

(defun goal-visible? (goal all)
  (or all (not (= (field goal :status) "closed"))))

(defun goal-list (result project issues)
  (let ((goals (filter-with 'type-issue? "goal" issues)))
    (let ((goals (filter-with 'issue-in-project? project goals)))
      (map-with 'goal-summary issues
        (filter-with 'goal-visible? (cli-result-option result "all") goals)))))

(defun indent (n)
  (if (<= n 0) "" (str "  " (indent (- n 1)))))

(defun tree-line (issue depth)
  (let ((kind (field issue :issue_type)))
    (str (indent depth)
         (field issue :id) " [" (field issue :status) "] "
         (field issue :title) " ("
         (if (nil? kind) "task" kind) ", p" (field issue :priority) ")")))

(defun tree-children (parent issues depth)
  (if (nil? issues) nil
      (if (= (field (first issues) :parent) parent)
          (append (tree-lines-for (first issues) issues depth)
                  (tree-children parent (rest issues) depth))
          (tree-children parent (rest issues) depth))))

(defun tree-lines-for (issue issues depth)
  (cons (tree-line issue depth)
        (tree-children (field issue :id) issues (+ depth 1))))

(defun goal-show (result)
  (let ((id (first (cli-result-args result))))
    (let ((root (issue-body id)))
      (let ((issues (issue-bodies-for (field root :project))))
        (list
          (list :issue root)
          (list :progress (progress-for issues id))
          (list :tree (tree-lines-for root issues 0)))))))

(defun goal-command (result actor now)
  (let ((project (project-filter result)))
    (let ((issues (if (nil? project) (all-issue-bodies)
                      (typed-bodies "issue/" "project" project))))
      (cond
        ((= (field result :path) "mb goal create")
          (if (nil? project) (mb-fail "goal create needs --project"))
          (create-work result project "goal" nil actor now))
        ((= (field result :path) "mb goal list")
          (or-empty (goal-list result project issues)))
        ((= (field result :path) "mb goal show") (goal-show result))
        (else (mb-fail "unknown goal command"))))))

(defun work-parent (result option expected)
  (let ((id (cli-result-option result option)))
    (if (nil? id) (mb-fail (str "missing --" option)))
    (let ((parent (issue-body id)))
      (if (not (= (field parent :issue_type) expected))
          (mb-fail (str id " is a " (field parent :issue_type) ", not a " expected)))
      parent)))

(defun epic-command (result actor now)
  (let ((parent (work-parent result "goal" "goal")))
    (create-work result (field parent :project) "epic" (field parent :id) actor now)))

(defun task-command (result actor now)
  (let ((parent (work-parent result "epic" "epic")))
    (create-work result (field parent :project) "task" (field parent :id) actor now)))

; ---------------------------------------------------------------------------
; Folders and project removal
; ---------------------------------------------------------------------------

(defun folder-view-row (body)
  body)

(defun project-folder-view (body)
  (list (list :project (field body :project))
        (list :folder (field body :folder))))

(defun folder-view ()
  (list
    (list :folders (or-empty (map 'folder-view-row (all-entry-bodies "folder/"))))
    (list :projects (or-empty (map 'project-folder-view (all-entry-bodies "project_folder/"))))))

(defun folder-create (result now)
  (let ((name (first (cli-result-args result)))
        (slug (cli-result-option result "slug"))
        (parent (cli-result-option result "parent")))
    (let ((slug (if (nil? slug) (slugify name) slug)))
      (if (= slug "") (mb-fail "folder name produced an empty slug"))
      (if (not (nil? parent))
          (if (nil? (body-of (entity "folder" parent)))
              (mb-fail (str "no folder " parent))))
      (let ((body (list (list :slug slug) (list :name name)
                        (list :parent parent) (list :created_at now))))
        (upsert-record "" (entity "folder" slug) "marbles.folder@1" body now)
        (list (list :slug slug))))))

(defun folder-move (result now)
  (let ((project (first (cli-result-args result)))
        (folder (nth 1 (cli-result-args result))))
    (if (nil? (body-of (entity "project" project)))
        (mb-fail (str "no project " project)))
    (let ((folder (if (or (= folder "none") (= folder "-") (= folder "")) nil folder)))
      (if (nil? folder)
          (begin
            (soil:records/delete (record-key "" (entity "project_folder" project)))
            (list (list :project project) (list :folder nil)))
          (begin
            (if (nil? (body-of (entity "folder" folder)))
                (mb-fail (str "no folder " folder)))
            (upsert-record "" (entity "project_folder" project) "marbles.project_folder@1"
              (list (list :project project) (list :folder folder)
                    (list :assigned_at now)) now)
            (list (list :project project) (list :folder folder)))))))

(defun delete-entry (entry)
  (if (nil? entry) nil
      (soil:records/delete (field entry :key))))

(defun delete-events-for (issue-id)
  (let ((events (query-entries "issue_id" issue-id)))
    (if (nil? events) nil (map 'delete-entry events))))

(defun drop-dependencies (mine)
  (let ((edges (all-entry-bodies "dependency/")))
    (if (nil? edges) nil
        (drop-dependency-rows (map 'entry-of (map 'dependency-entry-id edges)) mine))))

(defun dependency-entry-id (edge)
  (let ((child (field edge :child)) (parent (field edge :parent)))
    (entity2 "dependency" child parent)))

(defun drop-dependency-rows (entries mine)
  (if (nil? entries) nil
      (let ((entry (first entries)))
        (if (nil? entry) (drop-dependency-rows (rest entries) mine)
            (let ((body (entry-body entry)))
              (if (or (member? (field body :child) mine)
                      (member? (field body :parent) mine))
                  (delete-entry entry))
              (drop-dependency-rows (rest entries) mine))))))

(defun project-rm (result now)
  (let ((slug (first (cli-result-args result))))
    (if (nil? (body-of (entity "project" slug)))
        (mb-fail (str "no project " slug)))
    (let ((issues (typed-bodies "issue/" "project" slug)))
      (let ((mine (issue-ids issues)))
        (map 'delete-events-for mine)
        (drop-dependencies mine)
        (map 'delete-issue-entry issues)
        (delete-entry (entry-of (entity "project" slug)))
        (soil:records/delete (record-key "" (entity "project_folder" slug)))
        (list (list :removed slug) (list :issues (length (or-empty issues))))))))

(defun delete-issue-entry (issue)
  (delete-entry (entry-of (entity "issue" (field issue :id)))))

; ---------------------------------------------------------------------------
; Burndown
; ---------------------------------------------------------------------------

(defun created-by? (issue t)
  (<= (field issue :created_at) t))

(defun closed-by? (issue t)
  (let ((closed (field issue :closed_at)))
    (and (not (nil? closed)) (<= closed t))))

(defun count-with (pred arg issues)
  (length (or-empty (filter-with pred arg issues))))

(defun burndown-scope (result project)
  (let ((goal (cli-result-option result "goal"))
        (epic (cli-result-option result "epic")))
    (let ((root (if (nil? goal) epic goal)))
      (if (nil? root)
          (issue-bodies-for project)
          (let ((body (issue-body root)))
            (let ((issues (issue-bodies-for (field body :project))))
              (let ((ids (descendant-ids root issues)))
                (filter-with 'issue-in-ids? ids issues))))))))

(defun burndown-point (d issues total start now days)
  (let ((t (min (+ start (* d 86400)) now)))
    (let ((scope (count-with 'created-by? t issues))
          (done (count-with 'closed-by? t issues)))
      (list
        (list :date (date-string t))
        (list :scope scope)
        (list :done done)
        (list :remaining (max 0 (- scope done)))
        (list :ideal_remaining
          (max 0 (int (round (* total (- 1.0 (/ d days)))))))))))

(defun burndown-points (d issues total start now days)
  (if (> d days) nil
      (cons (burndown-point d issues total start now days)
            (burndown-points (+ d 1) issues total start now days))))

(defun bucket-count-until (t rows)
  (if (nil? rows) 0
      (let ((values (field (first rows) :values)))
        (if (nil? (first values))
            (bucket-count-until t (rest rows))
        (let ((bucket (int (json-decode (first values)))))
          (if (<= bucket t)
              (+ (field (first rows) :count)
                 (bucket-count-until t (rest rows)))
              0))))))

(defun buckets-total (rows)
  (if (nil? rows) 0
      (if (nil? (first (field (first rows) :values)))
          (buckets-total (rest rows))
          (+ (field (first rows) :count) (buckets-total (rest rows))))))

(defun burndown-filters (project)
  (if (nil? project) nil
      (list (records/filter "project" "eq" project))))

(defun burndown-buckets (project field)
  (let ((result (records/aggregate "" "issue/" (burndown-filters project) nil field 86400)))
    (if (not (ok? result))
        (mb-fail (str "burndown aggregate failed: " (field result :err)))
        (value result))))

(defun burndown-point-agg (d created closed start now days total)
  (let ((t (min (+ start (* d 86400)) now)))
    (let ((scope (bucket-count-until t created))
          (done (bucket-count-until t closed)))
      (list
        (list :date (date-string t))
        (list :scope scope)
        (list :done done)
        (list :remaining (max 0 (- scope done)))
        (list :ideal_remaining
          (max 0 (int (round (* total (- 1.0 (/ d days)))))))))))

(defun burndown-points-agg (d created closed start now days total)
  (if (> d days) nil
      (cons (burndown-point-agg d created closed start now days total)
            (burndown-points-agg (+ d 1) created closed start now days total))))

(defun burndown-command-aggregate (result project now)
  (let ((days (max 1 (or (option-int result "days") 30))))
    (let ((created (burndown-buckets project "created_at"))
          (closed (burndown-buckets project "closed_at")))
      (let ((total (buckets-total created))
            (start (- now (* days 86400))))
        (let ((done-start (bucket-count-until start closed))
              (done-now (bucket-count-until now closed)))
          (let ((elapsed (/ (- now start) 86400.0)))
            (let ((burn (if (and (> elapsed 0.0) (> done-now done-start))
                            (/ (- done-now done-start) elapsed)
                            nil)))
              (let ((remaining (max 0 (- total done-now))))
                (list
                  (list :days days)
                  (list :scope total)
                  (list :done done-now)
                  (list :remaining remaining)
                  (list :burn_per_day burn)
                  (list :projected_days_to_zero
                    (if (and (not (nil? burn)) (> burn 0.0)) (/ remaining burn) nil))
                  (list :points
                    (burndown-points-agg 0 created closed start now days total)))))))))))

(defun burndown-command (result project now)
  (let ((goal (cli-result-option result "goal"))
        (epic (cli-result-option result "epic")))
    (if (or (nil? goal) (nil? epic))
        (burndown-command-aggregate result project now)
        (let ((days (max 1 (or (option-int result "days") 30))))
          (let ((issues (or-empty (burndown-scope result project))))
            (let ((total (length issues))
                  (start (- now (* days 86400))))
              (let ((done-start (count-with 'closed-by? start issues))
                    (done-now (count-with 'closed-by? now issues)))
                (let ((elapsed (/ (- now start) 86400.0)))
                  (let ((burn (if (and (> elapsed 0.0) (> done-now done-start))
                                  (/ (- done-now done-start) elapsed)
                                  nil)))
                    (let ((remaining (max 0 (- total done-now))))
                      (list
                        (list :days days)
                        (list :scope total)
                        (list :done done-now)
                        (list :remaining remaining)
                        (list :burn_per_day burn)
                        (list :projected_days_to_zero
                          (if (and (not (nil? burn)) (> burn 0.0)) (/ remaining burn) nil))
                        (list :points
                          (burndown-points 0 issues total start now days)))))))))))))

; ---------------------------------------------------------------------------
; Plans (JSON specs; TOML is native-only for now)
; ---------------------------------------------------------------------------

(defun issue-meta (issue key)
  (field (field issue :metadata) key))

(defun plan-member? (issue name)
  (= (issue-meta issue :plan) name))

(defun plan-load (name)
  (let ((nodes (filter-with 'plan-member? name (all-issue-bodies))))
    (if (nil? nodes) (mb-fail (str "plan not found: " name)) nodes)))

(defun deps-of (id)
  (map 'edge-parent-id (dependency-edges "child" id)))

(defun edge-parent-id (edge)
  (field edge :parent))

(defun plan-id-set (nodes)
  (issue-ids nodes))

(defun id-in-ids? (id ids)
  (member? id ids))

(defun id-not-in-ids? (id ids)
  (not (member? id ids)))

(defun internal-deps (id nodes)
  (filter-with 'id-in-ids? (plan-id-set nodes) (deps-of id)))

(defun external-deps (id nodes)
  (filter-with 'id-not-in-ids? (plan-id-set nodes) (deps-of id)))

(defun plan-estimate (node)
  (let ((estimate (issue-meta node :estimate)))
    (if (nil? estimate) 30 (int estimate))))

(defun plan-node-view (node nodes)
  (let ((meta (field node :metadata)))
    (list
      (list :id (field node :id))
      (list :key (or (field meta :plan_key) (field node :id)))
      (list :title (field node :title))
      (list :status (field node :status))
      (list :repo (field meta :repo))
      (list :conflict_group (field meta :conflict_group))
      (list :risk (field meta :risk))
      (list :estimate (plan-estimate node))
      (list :done_means (field meta :done_means))
      (list :acceptance (field meta :acceptance))
      (list :deps (or-empty (internal-deps (field node :id) nodes)))
      (list :external_deps (or-empty (external-deps (field node :id) nodes)))
      (list :assignee (field node :assignee))
      (list :priority (field node :priority)))))

(defun plan-edges (nodes)
  (if (nil? nodes) nil
      (append (plan-node-edges (first nodes))
              (plan-edges (rest nodes)))))

(defun plan-node-edges (node)
  (let ((id (field node :id)))
    (map-with 'plan-edge id (deps-of id))))

(defun plan-edge (parent id)
  (list (list :child id) (list :parent parent)))

(defun unique-string (value values)
  (if (member? value values) values (cons value values)))

(defun plan-values (key nodes)
  (if (nil? nodes) nil
      (let ((value (issue-meta (first nodes) key)))
        (if (nil? value) (plan-values key (rest nodes))
            (unique-string value (plan-values key (rest nodes)))))))

(defun plan-view (name)
  (let ((nodes (plan-load name)))
    (list
      (list :plan name)
      (list :nodes (map-with 'plan-node-view nodes nodes))
      (list :edges (or-empty (plan-edges nodes)))
      (list :repos (or-empty (plan-values :repo nodes)))
      (list :conflict_groups (or-empty (plan-values :conflict_group nodes))))))

(defun plan-status (id nodes)
  (let ((node (find-body id nodes)))
    (if (nil? node) "missing" (field node :status))))

(defun deps-closed? (id nodes)
  (all? 'dep-closed? (deps-of id)))

(defun dep-closed? (id)
  (let ((node (body-of (entity "issue" id))))
    (and (not (nil? node)) (= (field node :status) "closed"))))

(defun plan-ready-node? (node context)
  (let ((now (first context)) (nodes (nth 1 context)))
    (and (= (field node :status) "open")
         (deps-closed? (field node :id) nodes)
         (issue-available? node now)
         (not (issue-claimed? node now)))))

(defun plan-blocked-node (node now nodes)
  (let ((id (field node :id))
        (key (or (issue-meta node :plan_key) (field node :id)))
        (title (field node :title)))
    (cond
      ((not (= (field node :status) "open"))
        (list (list :id id) (list :key key) (list :title title)
              (list :reason "not_open")
              (list :detail (str "status is " (field node :status)))))
      ((issue-claimed? node now)
        (list (list :id id) (list :key key) (list :title title)
              (list :reason "claim")
              (list :detail (str "claimed by " (field node :assignee)))))
      ((not (issue-available? node now))
        (list (list :id id) (list :key key) (list :title title)
              (list :reason "grace")
              (list :detail "not available yet")))
      ((not (deps-closed? id nodes))
        (list (list :id id) (list :key key) (list :title title)
              (list :reason "deps")
              (list :detail "waits on an open dependency")))
      (else nil))))

(defun plan-blocked (nodes now all)
  (if (nil? nodes) nil
      (if (plan-ready-node? (first nodes) (list now all))
          (plan-blocked (rest nodes) now all)
          (cons (plan-blocked-node (first nodes) now all)
                (plan-blocked (rest nodes) now all)))))

(defun plan-ready (name now)
  (let ((nodes (plan-load name)))
    (list
      (list :plan name)
      (list :ready (or-empty (map-with 'plan-node-view nodes
                       (filter-with 'plan-ready-node? (list now nodes) nodes))))
      (list :blocked (or-empty (plan-blocked nodes now nodes)))
      (list :busy_groups (json-object))
      (list :total_nodes (length nodes)))))

(defun plan-start-map (nodes finishes)
  (if (nil? nodes) 0
      (max (plan-node-start (first nodes) finishes)
           (plan-start-map (rest nodes) finishes))))

(defun plan-node-start (node finishes)
  (let ((deps (deps-of (field node :id))))
    (plan-dep-finish deps finishes)))

(defun plan-dep-finish (deps finishes)
  (if (nil? deps) 0
      (max (or (field finishes (keyword (first deps))) 0)
           (plan-dep-finish (rest deps) finishes))))

(defun plan-calc (nodes now finishes acc)
  (if (nil? nodes) (list finishes (reverse acc))
      (let ((node (first nodes)))
        (let ((start (plan-node-start node finishes))
              (duration (plan-estimate node)))
          (let ((entry (list (list :id (field node :id))
                             (list :start start)
                             (list :finish (+ start duration))
                             (list :duration duration)
                             (list :node node))))
            (plan-calc (rest nodes) now
              (assoc (keyword (field node :id)) (+ start duration) finishes)
              (cons entry acc)))))))

(defun plan-gantt (name now)
  (let ((nodes (plan-load name)))
    (let ((calculated (plan-calc nodes now nil nil)))
      (let ((finishes (first calculated))
            (rows (nth 1 calculated)))
        (let ((total (plan-total-finish nodes finishes)))
          (list
            (list :plan name)
            (list :started_at now)
            (list :nodes
              (map-with 'gantt-node-view (list finishes now) rows))
            (list :critical_path nil)
            (list :critical_path_minutes 0)
            (list :total_minutes total)
            (list :current_concurrency 0)
            (list :peak_concurrency 0)))))))

(defun plan-total-finish (nodes finishes)
  (if (nil? nodes) 0
      (max (or (field finishes (keyword (field (first nodes) :id))) 0)
           (plan-total-finish (rest nodes) finishes))))

(defun gantt-node-view (row context)
  (let ((node (field row :node))
        (finishes (first context))
        (now (nth 1 context)))
    (let ((start (field row :start))
          (finish (field row :finish))
          (estimate (field row :duration)))
      (list
        (list :id (field node :id))
        (list :key (or (issue-meta node :plan_key) (field node :id)))
        (list :title (field node :title))
        (list :status (field node :status))
        (list :repo (issue-meta node :repo))
        (list :conflict_group (issue-meta node :conflict_group))
        (list :estimate estimate)
        (list :estimate_source (if (nil? (issue-meta node :estimate)) "default" "metadata"))
        (list :start_min start)
        (list :finish_min finish)
        (list :slack_min 0)
        (list :critical #f)
        (list :start_at (+ now (* start 60)))
        (list :finish_at (+ now (* finish 60)))))))

(defun plan-create-meta (plan node)
  (let ((meta (list (list :plan plan)
                    (list :plan_key (field node :key)))))
    (let ((meta (if (nil? (field node :repo)) meta
                    (assoc :repo (field node :repo) meta))))
      (let ((meta (if (nil? (field node :conflict_group)) meta
                      (assoc :conflict_group (field node :conflict_group) meta))))
        (let ((meta (if (nil? (field node :risk)) meta
                        (assoc :risk (field node :risk) meta))))
          (let ((meta (if (nil? (field node :done_means)) meta
                          (assoc :done_means (field node :done_means) meta))))
            (let ((meta (if (nil? (field node :acceptance)) meta
                            (assoc :acceptance (field node :acceptance) meta))))
              (if (nil? (field node :estimate)) meta
                  (assoc :estimate (field node :estimate) meta)))))))))

(defun plan-create-node (plan project node actor now)
  (let ((project (or (field node :project) project)))
    (let ((prefix (project-prefix project nil)))
      (ensure-project project prefix now)
      (let ((id (candidate-id prefix now 0)))
        (let ((body (new-issue-body id project (field node :title)
                      (or (field node :description) "")
                      "task" (or (field node :priority) 2)
                      (field node :labels) nil now now
                      (plan-create-meta plan node) nil)))
          (save-issue body now)
          (log-event id now actor "created" (field node :title))
          id)))))

(defun plan-create-nodes (plan project nodes actor now ids)
  (if (nil? nodes) ids
      (let ((id (plan-create-node plan project (first nodes) actor now)))
        (plan-create-nodes plan project (rest nodes) actor now
          (assoc (keyword (field (first nodes) :key)) id ids)))))

(defun plan-create-edges (nodes ids actor now edges)
  (if (nil? nodes) (reverse edges)
      (let ((child (field ids (keyword (field (first nodes) :key)))))
        (let ((edge-list (plan-create-edge-list child (field (first nodes) :deps) ids actor now edges)))
          (plan-create-edges (rest nodes) ids actor now edge-list)))))

(defun plan-create-edge-list (child deps ids actor now edges)
  (if (nil? deps) edges
      (let ((parent (field ids (keyword (first deps)))))
        (if (nil? parent) (plan-create-edge-list child (rest deps) ids actor now edges)
            (begin
              (upsert-record "" (entity2 "dependency" child parent) "marbles.dependency@1"
                (list (list :child child) (list :parent parent)) now)
              (log-event child now actor "depends_on" parent)
              (plan-create-edge-list child (rest deps) ids actor now
                (cons (list (list :child child) (list :parent parent)) edges)))))))

(defun plan-create (result actor now)
  (let ((text (first (cli-result-args result))))
    (let ((spec (json-decode text)))
      (let ((plan (or (cli-result-option result "plan") (field spec :name) "plan")))
        (let ((project (or (cli-result-option result "project")
                           (field spec :project)
                           (project-filter result))))
          (if (nil? project) (mb-fail "plan create needs --project or MARBLES_PROJECT"))
          (let ((nodes (field spec :nodes)))
            (if (nil? nodes) (mb-fail "plan spec has no nodes"))
            (if (not (nil? (filter-with 'plan-member? plan (all-issue-bodies))))
                (mb-fail (str "plan " plan " already has nodes")))
            (if (cli-result-option result "dry-run")
                (list (list :plan plan) (list :project project)
                      (list :nodes nodes) (list :dry_run #t))
                (let ((ids (plan-create-nodes plan project nodes actor now nil)))
                  (let ((edges (plan-create-edges nodes ids actor now nil)))
                    (list
                      (list :plan plan)
                      (list :project project)
                      (list :nodes
                        (map-with 'plan-created-view (list plan ids project) nodes))
                      (list :edges (reverse edges))))))))))))

(defun plan-created-view (node context)
  (let ((plan (first context))
        (ids (nth 1 context))
        (plan-project (nth 2 context)))
    (let ((id (field ids (keyword (field node :key)))))
      (list
        (list :key (field node :key))
        (list :id id)
        (list :title (field node :title))
        (list :project (or (field node :project) plan-project))
        (list :deps (or-empty (field node :deps)))
        (list :metadata (plan-create-meta plan node))))))

(defun plan-command (result actor now)
  (let ((path (field result :path))
        (name (first (cli-result-args result))))
    (cond
      ((= path "mb plan show") (plan-view name))
      ((= path "mb plan gantt") (plan-gantt name now))
      ((= path "mb plan ready") (plan-ready name now))
      ((= path "mb plan create") (plan-create result actor now))
      (else (mb-fail "unknown plan command")))))

; ---------------------------------------------------------------------------
; Portfolio
; ---------------------------------------------------------------------------

(defun max-of (values)
  (if (nil? values) nil
      (max (first values) (or (max-of (rest values)) (first values)))))

(defun sum-of (values)
  (if (nil? values) 0
      (+ (first values) (sum-of (rest values)))))

(defun work-issue? (issue)
  (not (= (field issue :issue_type) "goal")))

(defun project-work? (issue project)
  (and (= (field issue :project) project) (work-issue? issue)))

(defun ready-work? (issue now)
  (and (work-issue? issue) (ready-issue? issue now)))

(defun stale-work? (issue context)
  (let ((now (first context)) (stale-days (nth 1 context)))
    (and (work-issue? issue)
         (or (= (field issue :status) "open")
             (= (field issue :status) "in_progress"))
         (< (field issue :updated_at) (- now (* stale-days 86400))))))

(defun review-work? (issue)
  (and (work-issue? issue) (= (field issue :status) "review")))

(defun ready-age (issue now)
  (max 0 (- now (field issue :created_at))))

(defun review-age (issue now)
  (max 0 (- now (field issue :updated_at))))

(defun project-goals (project issues)
  (or-empty (map-with 'goal-summary issues
    (filter-with 'issue-in-project? project
      (filter-with 'type-issue? "goal" issues)))))

(defun project-rollup (project all now days stale-days)
  (let ((slug (field project :slug)))
    (let ((work (filter-with 'project-work? slug all)))
      (let ((ready (filter-with 'ready-work? now work)))
        (let ((stale (filter-with 'stale-work? (list now stale-days) work))
              (review (filter 'review-work? work)))
          (list
            (list :slug slug)
            (list :folder (field project :folder))
            (list :prefix (field project :prefix))
            (list :progress (progress-of work))
            (list :ready (length (or-empty ready)))
            (list :oldest_ready_age_secs
              (if (nil? ready) nil (max-of (map-with 'ready-age now ready))))
            (list :stale (length (or-empty stale)))
            (list :oldest_review_age_secs
              (if (nil? review) nil (max-of (map-with 'review-age now review))))
            (list :burn_per_day nil)
            (list :goals (project-goals slug all))))))))

(defun project-rollups (projects all now days stale-days)
  (if (or (nil? projects) (= 0 (length projects))) nil
      (cons (project-rollup (first projects) all now days stale-days)
            (project-rollups (rest projects) all now days stale-days))))

(defun rollup-field-sum (key rollups)
  (sum-of (map-with 'rollup-field key rollups)))

(defun rollup-field (rollup key)
  (field rollup key))

(defun folder-rollup (folder projects all now days stale-days)
  (let ((slug (field folder :slug)))
    (let ((mine (filter-with 'project-in-folder? slug projects)))
      (let ((rollups (project-rollups mine all now days stale-days)))
        (let ((work (filter-with 'project-in-folder-work? (list slug projects) all)))
          (list
            (list :slug slug)
            (list :name (field folder :name))
            (list :parent (field folder :parent))
            (list :projects rollups)
            (list :progress (progress-of work))
            (list :ready (rollup-field-sum :ready rollups))
            (list :stale (rollup-field-sum :stale rollups))
            (list :burn_per_day nil)))))))

(defun project-in-folder? (project folder)
  (= (field project :folder) folder))

(defun find-project (slug projects)
  (cond ((nil? projects) nil)
        ((= (field (first projects) :slug) slug) (first projects))
        (else (find-project slug (rest projects)))))

(defun project-in-folder-work? (issue context)
  (let ((folder (first context)) (projects (nth 1 context)))
    (let ((info (find-project (field issue :project) projects)))
      (and (not (nil? info)) (= (field info :folder) folder)))))

(defun folder-rollups (folders projects all now days stale-days)
  (if (nil? folders) nil
      (let ((rollup (folder-rollup (first folders) projects all now days stale-days)))
        (if (nil? (field rollup :projects))
            (folder-rollups (rest folders) projects all now days stale-days)
            (cons rollup (folder-rollups (rest folders) projects all now days stale-days))))))

(defun known-folder? (slug folders)
  (if (nil? folders) #f
      (if (= (field (first folders) :slug) slug) #t
          (known-folder? slug (rest folders)))))

(defun unfiled-rollups (rollups folders)
  (if (nil? rollups) nil
      (if (or (nil? (field (first rollups) :folder))
              (not (known-folder? (field (first rollups) :folder) folders)))
          (cons (first rollups) (unfiled-rollups (rest rollups) folders))
          (unfiled-rollups (rest rollups) folders))))

(defun portfolio-command (result now)
  (let ((folder (cli-result-option result "folder"))
        (days (or (option-int result "days") 14))
        (stale-days (or (option-int result "stale-days") 7)))
    (let ((all (or-empty (all-issue-bodies))))
      (let ((projects (project-summaries)))
        (let ((projects (if (nil? folder) projects
                            (filter-with 'project-in-folder? folder projects))))
          (let ((folders (if (nil? folder) (all-entry-bodies "folder/")
                             (filter-with 'folder-slug? folder (all-entry-bodies "folder/")))))
            (let ((rollups (project-rollups projects all now days stale-days)))
              (let ((work (filter 'work-issue? all))
                    (ready (filter-with 'ready-work? now work))
                    (stale (filter-with 'stale-work? (list now stale-days) work)))
                (list
                  (list :generated_at now)
                  (list :days days)
                  (list :stale_days stale-days)
                  (list :folders (or-empty (folder-rollups folders projects all now days stale-days)))
                  (list :unfiled (or-empty (unfiled-rollups rollups folders)))
                  (list :totals
                    (list
                      (list :projects (length (or-empty projects)))
                      (list :progress (progress-of work))
                      (list :ready (length (or-empty ready)))
                      (list :stale (length (or-empty stale)))
                      (list :burn_per_day nil))))))))))))

(defun folder-slug? (folder slug)
  (= (field folder :slug) slug))

; ---------------------------------------------------------------------------
; Dispatch
; ---------------------------------------------------------------------------

(defun mb-result (result actor now)
  (let ((path (field result :path))
        (project (project-filter result)))
    (cond
      ((= path "mb list")
        (or-empty (list-project project (cli-result-option result "id")
          (cli-result-option result "all") (limit-option result))))
      ((= path "mb ready") (or-empty (ready-project project)))
      ((= path "mb show") (let ((id (first (cli-result-args result))))
                            (list (issue-with-counts (issue-body id)))))
      ((= path "mb history") (or-empty (history-issue (first (cli-result-args result)))))
      ((= path "mb create") (create-issue result actor now))
      ((= path "mb update") (update-issue result actor now))
      ((= path "mb claim") (claim-command result actor now))
      ((= path "mb touch") (touch-issue result actor now))
      ((= path "mb release") (release-issue result actor now))
      ((= path "mb review") (review-issue result actor now))
      ((= path "mb close") (close-issue result actor now))
      ((= path "mb dep add") (dep-add result actor now))
      ((= path "mb dep rm") (dep-rm result actor now))
      ((= path "mb label add") (label-add result actor now))
      ((= path "mb label rm") (label-rm result actor now))
      ((= path "mb stats") (stats-command))
      ((= path "mb supersede") (supersede-issue result actor now))
      ((= path "mb sweep") (sweep-command now))
      ((= path "mb projects") (or-empty (project-summaries)))
      ((= path "mb doctor") (doctor-command))
      ((= path "mb goal create") (goal-command result actor now))
      ((= path "mb goal list") (goal-command result actor now))
      ((= path "mb goal show") (goal-command result actor now))
      ((= path "mb epic create") (epic-command result actor now))
      ((= path "mb task create") (task-command result actor now))
      ((= path "mb project rm") (project-rm result now))
      ((= path "mb folder create") (folder-create result now))
      ((= path "mb folder list") (folder-view))
      ((= path "mb folder tree") (folder-view))
      ((= path "mb folder move") (folder-move result now))
      ((= path "mb burndown") (burndown-command result project now))
      ((= path "mb plan show") (plan-command result actor now))
      ((= path "mb plan gantt") (plan-command result actor now))
      ((= path "mb plan ready") (plan-command result actor now))
      ((= path "mb plan create") (plan-command result actor now))
      ((= path "mb portfolio") (portfolio-command result now))
      (else (mb-fail (str "unsupported command: " path))))))

(defun marbles-result (command args)
  (let ((parsed (cli-parse-argv (mb-spec) (cons command args))))
    (if (cli-ok? parsed)
        (mb-result (field parsed :ok) "agent" (now-seconds))
        (mb-fail (field parsed :error)))))

(defun marbles (command args)
  (println (json-encode (marbles-result command args))))

; Load in a REPL and call these; each delegates to the same parser as `mb`.
(defun marbles-list (project)
  (marbles-result "list" (list "--project" project)))
(defun marbles-ready (project)
  (marbles-result "ready" (list "--project" project)))
(defun marbles-show (id)
  (marbles-result "show" (list id)))

(defun mb-dispatch (result actor now)
  (println (json-encode (mb-result result actor now))))

(defun main ()
  (let ((parsed (cli-parse-argv (mb-spec) (cli-args))))
    (if (cli-ok? parsed)
        (let ((result (field parsed :ok)))
          (mb-dispatch result (actor-name result) (now-seconds)))
        (mb-fail (field parsed :error)))))
