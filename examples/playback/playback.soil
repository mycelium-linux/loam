; SPDX-License-Identifier: MIT OR Apache-2.0
; Playback control for deadwax/MPD and Spotify.
;
; This is the HTTP-backed slice. The durable guest contract is `soil:playback`
; (snapshot/send/search/desk) whose host adapter speaks the `audio.playback.*`
; Unibus kinds; this file keeps the same vocabulary so the transport can be
; swapped without changing a program.
;
; Soil has no `defmacro` yet, so the common verbs are one dispatcher
; (`playback/control`) instead of one `defun` per verb. The URL/body builders
; stay separate so they are testable without a host.

(defun playback/kind (source)
  (field source :kind))

(defun playback/slash? (character)
  (= character "/"))

(defun playback/trim-slash (text)
  (string-join
    (reverse (drop-while 'playback/slash? (reverse (string-chars text))))
    ""))

(defun playback/encode (text)
  (string-replace
    (string-replace
      (string-replace
        (string-replace
          (string-replace text "+" "%2B")
          "&" "%26")
        "?" "%3F")
      "#" "%23")
    " " "+"))

(defun playback/header (name value)
  (list (list :name name) (list :value value)))

(defun playback/headers (body)
  (if (nil? body)
      (list (playback/header "accept" "application/json"))
      (list
        (playback/header "accept" "application/json")
        (playback/header "content-type" "application/json"))))

(defun playback/check (response)
  (let ((response (value response)))
    (let ((status (field response :status)))
      (if (and (>= status 200) (< status 300))
          (let ((body (field response :body)))
            (if (= (length body) 0)
                (list 'ok nil)
                (list 'ok (json-decode body))))
          (list 'err (str "playback: HTTP " status))))))

(defun playback/fetch (url method credential body)
  (let ((response
          (soil:http/fetch
            (list
              (list :url url)
              (list :method method)
              (list :headers (playback/headers body))
              (list :body (if (nil? body) nil (json-encode body)))
              (list :credential credential)
              (list :max-bytes 1048576)
              (list :timeout-ms 10000)))))
    (if (ok? response)
        (playback/check response)
        response)))

;;; ---------------------------------------------------------------------------
;;; deadwax / MPD
;;; ---------------------------------------------------------------------------

(defun deadwax/source (base)
  (list
    (list :kind "deadwax")
    (list :base (playback/trim-slash base))))

(defun deadwax/url (source path)
  (str (field source :base) path))

(defun deadwax/get (source path)
  (playback/fetch (deadwax/url source path) "get" nil nil))

(defun deadwax/post (source path body)
  (playback/fetch (deadwax/url source path) "post" nil body))

(defun deadwax/health (source)
  (deadwax/get source "/health"))

(defun deadwax/status (source)
  (deadwax/get source "/mpd/status"))

(defun deadwax/queue (source)
  (deadwax/get source "/mpd/queue"))

(defun deadwax/search-path (query limit)
  (str "/search?q=" (playback/encode query) "&limit=" limit))

(defun deadwax/search (source query limit)
  (deadwax/get source (deadwax/search-path query limit)))

(defun deadwax/tracks (source limit)
  (deadwax/get source (str "/tracks?limit=" limit)))

(defun deadwax/playlists (source)
  (deadwax/get source "/playlists?coverage=1"))

(defun deadwax/control (source verb value)
  (cond
    ((= verb "play") (deadwax/post source "/mpd/play" nil))
    ((= verb "pause") (deadwax/post source "/mpd/pause" nil))
    ((= verb "toggle") (deadwax/post source "/mpd/toggle" nil))
    ((= verb "next") (deadwax/post source "/mpd/next" nil))
    ((= verb "prev") (deadwax/post source "/mpd/prev" nil))
    ((= verb "stop") (deadwax/post source "/mpd/stop" nil))
    ((= verb "seek")
      (deadwax/post source (str "/mpd/seek?seconds=" value) nil))
    ((= verb "volume")
      (deadwax/post source (str "/mpd/volume?level=" value) nil))
    ((= verb "add")
      (deadwax/post
        source (str "/mpd/add?uri=" (playback/encode value)) nil))
    ((= verb "play-position")
      (deadwax/post source (str "/mpd/play?position=" value) nil))
    ((= verb "play-playlist")
      (deadwax/post
        source
        (str "/queue/playlist?user=" (playback/encode (nth 0 value))
             "&name=" (playback/encode (nth 1 value)))
        nil))
    (else
      (list 'err (str "deadwax: unknown command " verb)))))

;;; ---------------------------------------------------------------------------
;;; Spotify Connect
;;; ---------------------------------------------------------------------------

(defun spotify/source (credential device)
  (list
    (list :kind "spotify")
    (list :base "https://api.spotify.com")
    (list :credential credential)
    (list :device device)))

(defun spotify/url (source path)
  (str (field source :base) path))

(defun spotify/get (source path)
  (playback/fetch
    (spotify/url source path) "get" (field source :credential) nil))

(defun spotify/send (source method path body)
  (playback/fetch
    (spotify/url source path) method (field source :credential) body))

(defun spotify/status (source)
  (spotify/get source "/v1/me/player"))

(defun spotify/devices (source)
  (spotify/get source "/v1/me/player/devices"))

(defun spotify/with-device (path device-id)
  (if (nil? device-id)
      path
      (str path
        (if (string-contains? path "?") "&" "?")
        "device_id=" device-id)))

(defun spotify/play-uri (text)
  (let ((uri (string-replace text "https://open.spotify.com/" "spotify:")))
    (string-replace uri "/" ":")))

(defun spotify/play-body (uri)
  (if (nil? uri)
      nil
      (let ((uri (spotify/play-uri uri)))
        (if (or (string-contains? uri "spotify:track:")
                (string-contains? uri "spotify:episode:"))
            (list (list :uris (list uri)))
            (list (list :context_uri uri))))))

(defun spotify/control (source verb value)
  (let ((device (field source :device)))
    (cond
      ((= verb "play")
        (spotify/send
          source "put"
          (spotify/with-device "/v1/me/player/play" device)
          (spotify/play-body value)))
      ((= verb "pause")
        (spotify/send
          source "put"
          (spotify/with-device "/v1/me/player/pause" device)
          nil))
      ((= verb "next")
        (spotify/send
          source "post"
          (spotify/with-device "/v1/me/player/next" device)
          nil))
      ((= verb "prev")
        (spotify/send
          source "post"
          (spotify/with-device "/v1/me/player/previous" device)
          nil))
      ((= verb "volume")
        (spotify/send
          source "put"
          (spotify/with-device
            (str "/v1/me/player/volume?volume_percent=" value) device)
          nil))
      ((= verb "seek")
        (spotify/send
          source "put"
          (spotify/with-device
            (str "/v1/me/player/seek?position_ms=" value) device)
          nil))
      ((= verb "shuffle")
        (spotify/send
          source "put"
          (spotify/with-device
            (str "/v1/me/player/shuffle?state=" (if value "true" "false"))
            device)
          nil))
      ((= verb "repeat")
        (spotify/send
          source "put"
          (spotify/with-device
            (str "/v1/me/player/repeat?state=" value) device)
          nil))
      ((= verb "queue")
        (spotify/send
          source "post"
          (spotify/with-device
            (str "/v1/me/player/queue?uri=" (playback/encode value))
            device)
          nil))
      (else
        (list 'err (str "spotify: unknown command " verb))))))

(defun spotify/transfer (source device-id play)
  (spotify/send
    source "put" "/v1/me/player"
    (list
      (list :device_ids (list device-id))
      (list :play play))))

(defun spotify/search (source query limit)
  (spotify/get
    source
    (str "/v1/search?q=" (playback/encode query)
         "&type=track&limit=" limit)))

(defun spotify/device-id-by-name (devices name)
  (cond
    ((nil? devices) nil)
    ((= (field (first devices) :name) name)
      (field (first devices) :id))
    (else (spotify/device-id-by-name (rest devices) name))))

;;; ---------------------------------------------------------------------------
;;; One vocabulary over both owners
;;; ---------------------------------------------------------------------------

(defun playback/status (source)
  (if (= (playback/kind source) "deadwax")
      (deadwax/status source)
      (spotify/status source)))

(defun playback/control (source verb value)
  (cond
    ((= (playback/kind source) "deadwax")
      (deadwax/control source verb value))
    ((= (playback/kind source) "spotify")
      (spotify/control source verb value))
    (else
      (list 'err (str "playback: unknown source " (playback/kind source))))))

;;; ---------------------------------------------------------------------------
;;; Snapshot and small parsing helpers used by the CLI and the home library
;;; ---------------------------------------------------------------------------

(defun playback/current-item (items)
  (cond
    ((nil? items) nil)
    ((field (first items) :current) (first items))
    (else (playback/current-item (rest items)))))

;;; Health, MPD status, the queue, and the current queue item in one bounded
;;; record. A dashboard should not have to make three independent calls.
(defun deadwax/snapshot (source)
  (let ((health (deadwax/health source)))
    (if (ok? health)
        (let ((status (deadwax/status source)))
          (if (ok? status)
              (let ((queue (deadwax/queue source)))
                (if (ok? queue)
                    (list 'ok
                      (list
                        (list :health (value health))
                        (list :status (value status))
                        (list :queue (value queue))
                        (list :current
                          (playback/current-item
                            (field (value queue) :items)))))
                    queue))
              status))
        health)))

(defun playback/snapshot (source)
  (if (= (playback/kind source) "deadwax")
      (deadwax/snapshot source)
      (list 'ok (list (list :status (spotify/status source))))))

(defun deadwax/playlist-owner (entry)
  (field entry :owner))

(defun deadwax/playlist (entry)
  (field entry :playlist))

(defun deadwax/playlist-name (entry)
  (field (deadwax/playlist entry) :name))

(defun deadwax/playlist-kind (entry)
  (field (deadwax/playlist entry) :kind))

(defun playback/digit (character)
  (cond
    ((= character "0") 0)
    ((= character "1") 1)
    ((= character "2") 2)
    ((= character "3") 3)
    ((= character "4") 4)
    ((= character "5") 5)
    ((= character "6") 6)
    ((= character "7") 7)
    ((= character "8") 8)
    ((= character "9") 9)
    (else nil)))

(defun playback/digits (characters value)
  (if (nil? characters)
      (list 'ok value)
      (let ((digit (playback/digit (first characters))))
        (if (nil? digit)
            (list 'err (str "not a number: " (string-join characters "")))
            (playback/digits (rest characters) (+ (* value 10) digit))))))

(defun playback/int (text)
  (let ((characters (string-chars text)))
    (if (nil? characters)
        (list 'err "expected a number")
        (playback/digits characters 0))))
