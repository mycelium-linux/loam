#!/usr/bin/env bash
# Thin host launcher for the Soil Hue CLI.
#
# The command surface is examples/hue/hue_cli.soil; this script only supplies
# the host policy the Soil host cannot set for itself: the bridge origin, the
# Geode socket/reference, and the workspace/records roots.
set -euo pipefail

here=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
root=$(CDPATH= cd -- "$here/../.." && pwd)

SOIL_LANG=${SOIL_LANG:-}
if [[ -z "$SOIL_LANG" ]]; then
  if [[ -x "$root/.bin/soil-lang" ]]; then
    SOIL_LANG="$root/.bin/soil-lang"
  else
    SOIL_LANG="$root/target/debug/soil-lang"
  fi
fi
if [[ ! -x "$SOIL_LANG" ]]; then
  echo "hue: no soil-lang binary at $SOIL_LANG (build soil-lang or set SOIL_LANG)" >&2
  exit 2
fi

bridge=${HUE_BRIDGE:-}
geode_socket=${HUE_GEODE_SOCKET:-"$HOME/.geode/geode.sock"}
geode_reference=${HUE_GEODE_REFERENCE:-geode://home/hue/bridge}
geode_purpose=${HUE_GEODE_PURPOSE:-hue.control}
cache=${XDG_CACHE_HOME:-"$HOME/.cache"}/soil/hue
workspace=${HUE_WORKSPACE:-"$cache/workspace"}
records=${HUE_RECORDS:-"$cache/records"}

args=("$@")
has_bridge=0
command=""
skip=0
for ((i = 0; i < ${#args[@]}; i++)); do
  arg=${args[$i]}
  if [[ $skip -eq 1 ]]; then
    skip=0
    continue
  fi
  case "$arg" in
    --bridge)
      bridge=${args[$((i + 1))]:-}
      has_bridge=1
      skip=1
      ;;
    --bridge=*)
      bridge=${arg#--bridge=}
      has_bridge=1
      ;;
    --credential | --room | --group | --snapshot-json)
      skip=1
      ;;
    --* ) ;;
    *)
      if [[ -z "$command" ]]; then command=$arg; fi
      ;;
  esac
done

inject_bridge=0
allow_bridge=$bridge
case "$command" in
  discover | moods)
    if [[ -z "$allow_bridge" ]]; then allow_bridge="http://127.0.0.1"; fi
    ;;
esac
if [[ -z "$allow_bridge" ]]; then
  if [[ " $* " == *" --help "* || " $* " == *" -h "* ]]; then
    allow_bridge="http://127.0.0.1"
  else
    echo "hue: set HUE_BRIDGE or pass --bridge (the host needs the exact origin)" >&2
    exit 2
  fi
fi
case "$allow_bridge" in
  http://* | https://*) ;;
  *) allow_bridge="http://$allow_bridge" ;;
esac
allow_bridge=${allow_bridge%/}
if [[ -n "$bridge" ]]; then
  bridge=${bridge%/}
  case "$bridge" in
    http://* | https://*) ;;
    *) bridge="http://$bridge" ;;
  esac
fi

if [[ $has_bridge -eq 0 && -n "$bridge" ]]; then
  inject_bridge=1
fi
if [[ $inject_bridge -eq 1 ]]; then
  args+=(--bridge "$bridge")
fi

mkdir -p "$workspace" "$records"
if [[ ! -S "$geode_socket" ]]; then
  echo "hue: no Geode socket at $geode_socket (set HUE_GEODE_SOCKET)" >&2
  exit 2
fi

exec "$SOIL_LANG" \
  --workspace-root "$workspace" \
  --records-root "$records" \
  --prelude "$root/crates/soil-lang/stdlib/prelude.soil" \
  --allow "$allow_bridge" \
  --allow "https://discovery.meethue.com" \
  --geode-socket "$geode_socket" \
  --geode-reference "$geode_reference" \
  --geode-purpose "$geode_purpose" \
  "$root/crates/soil-lang/stdlib/cli.soil" \
  "$root/crates/soil-lang/bindings/wasi-cli.soil" \
  "$root/crates/soil-lang/bindings/soil-http.soil" \
  "$root/examples/hue/hue.soil" \
  "$root/examples/hue/hue_cli.soil" \
  -- "${args[@]}"
