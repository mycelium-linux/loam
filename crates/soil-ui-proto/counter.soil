; SPDX-License-Identifier: MIT OR Apache-2.0
; The first editable Soil UI slice.
;
; This file is the only place the interface is defined. The host calls these
; four functions, turns the returned forms into DOM nodes, and applies the CSS.
; Edit this file in the browser panel (or in an editor) and press Apply.

(defun initial-state ()
  0)

(defun update (state action)
  (cond
    ((= action "inc") (+ state 1))
    ((= action "dec") (- state 1))
    ((= action "reset") 0)
    (else state)))

;;; UI forms -------------------------------------------------------------
;;
;; A node is a record with :tag, :attrs, :children.
;; A text node is a record with :text.
;; Attributes are (keyword value) pairs.

(defun attr (key value)
  (list key value))

(defun el (tag attrs children)
  (list
    (list :tag tag)
    (list :attrs attrs)
    (list :children children)))

(defun txt (value)
  (list (list :text (str value))))

(defun view (state)
  (el "div" (list (attr :class "app"))
    (list
      (el "header" (list (attr :class "topbar"))
        (list
          (el "div" (list (attr :class "brand"))
            (list
              (txt "SOIL")
              (el "span" (list (attr :class "brand-sub"))
                (list (txt "editable ui")))))
          (el "div" (list (attr :class "pill"))
            (list (txt "lisp → html/css")))))
      (el "main" (list (attr :class "stage"))
        (list
          (el "section" (list (attr :class "card"))
            (list
              (el "p" (list (attr :class "eyebrow"))
                (list (txt "COUNTER")))
              (el "output" (list (attr :class "value"))
                (list (txt state)))
              (el "p" (list (attr :class "hint"))
                (list (txt "The form comes from Lisp. The host only reconciles DOM nodes and sends actions back.")))
              (el "div" (list (attr :class "row"))
                (list
                  (el "button" (list (attr :class "btn") (attr :data-action "dec"))
                    (list (txt "−")))
                  (el "button" (list (attr :class "btn ghost") (attr :data-action "reset"))
                    (list (txt "Reset")))
                  (el "button" (list (attr :class "btn primary") (attr :data-action "inc"))
                    (list (txt "+")))))))
          (el "section" (list (attr :class "card soft"))
            (list
              (el "h2" nil
                (list (txt "A form you can read")))
              (el "pre" (list (attr :class "code"))
                (list (txt "(el \"div\" (list (attr :class \"app\")) …)")))
              (el "p" (list (attr :class "hint"))
                (list (txt "Open counter.soil in the panel, change the markup or the CSS, and press Apply. The server re-runs this file."))))))))))

;;; Stylesheet ------------------------------------------------------------
;;
;; Real CSS, injected as one <style> element by the host.

(defun styles ()
  (str
    ":root {\n"
    "  color-scheme: dark;\n"
    "  --ink: #e9ecf2;\n"
    "  --muted: #8b93a7;\n"
    "  --line: rgba(255,255,255,.08);\n"
    "  --panel: #141821;\n"
    "  --panel-2: #191f2b;\n"
    "  --accent: #c8f169;\n"
    "  --accent-ink: #18200a;\n"
    "}\n"
    "* { box-sizing: border-box; }\n"
    ".app {\n"
    "  min-height: 100vh;\n"
    "  padding: 28px clamp(20px, 5vw, 64px) 64px;\n"
    "  color: var(--ink);\n"
    "  background:\n"
    "    radial-gradient(900px 480px at 15% -10%, rgba(200,241,105,.10), transparent 60%),\n"
    "    radial-gradient(700px 420px at 95% 5%, rgba(110,140,255,.10), transparent 55%),\n"
    "    #0b0d12;\n"
    "  font: 15px/1.55 ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif;\n"
    "}\n"
    ".topbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; }\n"
    ".brand { font-weight: 800; letter-spacing: .18em; font-size: 13px; }\n"
    ".brand-sub { margin-left: 10px; color: var(--muted); font-weight: 500; letter-spacing: .04em; text-transform: lowercase; }\n"
    ".pill {\n"
    "  border: 1px solid var(--line); border-radius: 999px;\n"
    "  padding: 6px 12px; color: var(--muted); font-size: 12px;\n"
    "  background: rgba(255,255,255,.03);\n"
    "}\n"
    ".stage {\n"
    "  margin-top: clamp(40px, 8vh, 96px);\n"
    "  display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);\n"
    "  gap: 20px; align-items: start; max-width: 1080px;\n"
    "}\n"
    ".card {\n"
    "  border: 1px solid var(--line); border-radius: 20px;\n"
    "  padding: clamp(22px, 4vw, 38px);\n"
    "  background: linear-gradient(180deg, rgba(255,255,255,.035), transparent 60%), var(--panel);\n"
    "  box-shadow: 0 24px 70px rgba(0,0,0,.38);\n"
    "}\n"
    ".card.soft { background: var(--panel-2); }\n"
    ".eyebrow { margin: 0 0 8px; color: var(--muted); font-size: 11px; letter-spacing: .22em; }\n"
    ".value { display: block; font: 700 clamp(64px, 12vw, 128px)/.9 ui-sans-serif, system-ui, sans-serif; letter-spacing: -.05em; font-variant-numeric: tabular-nums; }\n"
    ".hint { margin: 14px 0 22px; color: var(--muted); max-width: 46ch; }\n"
    ".row { display: flex; gap: 10px; flex-wrap: wrap; }\n"
    ".btn {\n"
    "  appearance: none; border: 1px solid var(--line); border-radius: 12px;\n"
    "  padding: 11px 18px; min-width: 48px; cursor: pointer;\n"
    "  color: var(--ink); background: rgba(255,255,255,.045);\n"
    "  font: 600 14px/1 ui-sans-serif, system-ui, sans-serif;\n"
    "  transition: transform .08s ease, background .15s ease, border-color .15s ease;\n"
    "}\n"
    ".btn:hover { background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.16); }\n"
    ".btn:active { transform: translateY(1px); }\n"
    ".btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n"
    ".btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }\n"
    ".btn.primary:hover { background: #d7ff7d; }\n"
    ".btn.ghost { color: var(--muted); }\n"
    ".card h2 { margin: 0 0 12px; font-size: 18px; letter-spacing: -.01em; }\n"
    ".code {\n"
    "  margin: 0 0 16px; padding: 14px 16px; overflow-x: auto;\n"
    "  border: 1px solid var(--line); border-radius: 12px;\n"
    "  background: #0d1016; color: #d7e0f5;\n"
    "  font: 12.5px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace;\n"
    "  white-space: pre-wrap;\n"
    "}\n"
    "@media (max-width: 820px) { .stage { grid-template-columns: 1fr; } }\n"
    "@media (prefers-reduced-motion: reduce) { .btn { transition: none; } }\n"))
