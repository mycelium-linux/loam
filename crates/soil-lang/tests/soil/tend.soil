(defun tend/sample ()
  "(tend\n  (version 1)\n  (members \"crates/*\")\n  (test \"soil-lang\" (include \"crates/soil-lang/tests/soil/*.soil\") (prelude \"crates/soil-lang/stdlib/prelude.soil\"))\n  (bench \"runtime\" (include \"benches/*.soil\") (runs 100))\n  (dependency \"soil-spore\" (path \"crates/soil-spore\")))\n")

(defun test/tend-manifest ()
  (let ((result (tend/parse (tend/sample))))
    (and (ok? result)
         (= (field (value result) :version) 1)
         (= (field (first (field (value result) :tests)) :name) "soil-lang")
         (= (field (first (field (value result) :benches)) :runs) 100)
         (= (field (first (field (value result) :dependencies)) :kind) "path"))))

(defun test/tend-roundtrip ()
  (let ((result (tend/parse (tend/sample))))
    (and (ok? result)
         (= (tend/emit (value result))
            (str "(tend\n"
                 "  (version 1)\n"
                 "  (members \"crates/*\")\n"
                 "  (test \"soil-lang\"\n"
                 "    (include \"crates/soil-lang/tests/soil/*.soil\")\n"
                 "    (prelude \"crates/soil-lang/stdlib/prelude.soil\")\n"
                 "  )\n"
                 "  (bench \"runtime\"\n"
                 "    (include \"benches/*.soil\")\n"
                 "    (runs 100)\n"
                 "  )\n"
                 "  (dependency \"soil-spore\" (path \"crates/soil-spore\"))\n"
                 ")\n")))))

(defun test/tend-refuses-unknown ()
  (and (not (ok? (tend/parse "(tend (version 1) (members \"x\") (eval \"rm\"))")))
       (not (ok? (tend/parse "(tend (members \"x\"))")))
       (not (ok? (tend/parse "(tend (version 1) (members \"x\") (test \"t\"))")))))

(defun lint/sample ()
  "(defun main () (used 1))
(defun used (x) x)
(defun unused () 1)
(defun bad () (used))")

(defun test/tend-lint ()
  (let ((result (tend/lint (lint/sample) (list 'main 'bad))))
    (and (ok? result)
         (= (field (value result) :dead) (list 'unused))
         (= (tend/count (field (value result) :arity)) 1)
         (= (field (first (field (value result) :arity)) :function) 'used)
         (= (field (first (field (value result) :arity)) :expected) 1)
         (= (field (first (field (value result) :arity)) :got) 0))))

(defun test/tend-lint-duplicate ()
  (let ((result (tend/lint "(defun main () 1)\n(defun main () 2)" (list 'main))))
    (and (ok? result)
         (= (field (value result) :duplicates) (list 'main)))))

(defun doc/sample ()
  ";;; # Module\n;;; A module doc.\n(defun foo () 1)\n;;; Foo docs.\n;;; - item\n(defun bar () 2)\n")

(defun test/tend-doc ()
  (let ((result (tend/doc (doc/sample))))
    (and (ok? result)
         (= (field (value result) :module) "# Module\nA module doc.")
         (= (field (first (field (value result) :functions)) :name) 'foo)
         (= (field (nth 1 (field (value result) :functions)) :name) 'bar)
         (= (field (nth 1 (field (value result) :functions)) :markdown) "Foo docs.\n- item"))))

(defun test/tend-license ()
  (and (ok? (tend/license-check "; SPDX-License-Identifier: MIT OR Apache-2.0\n"))
       (not (ok? (tend/license-check "(defun foo () 1)\n")))))

(defun test/tend-command ()
  (let ((result
          (tend/parse
            "(tend (version 1) (members \"x\") (command \"fmt\" (summary \"Format\") (run \"tools/fmt.soil\" \"main\")))")))
    (and (ok? result)
         (= (field (first (field (value result) :commands)) :name) "fmt")
         (= (field (first (field (value result) :commands)) :summary) "Format"))))

(defun test/tend-fmt ()
  (let ((source "(defun greet (name)\n  (list 'hello name))\n")
        (formatted "(defun greet (name)\n  (list 'hello name)\n)\n"))
    (= (tend/fmt source) formatted)))

(defun test/tend-dispatch ()
  (let ((manifest
          "(tend (version 1) (members \"x\") (command \"fmt\" (summary \"Format\") (run \"tools/tend/fmt.soil\" \"main\")))"))
    (let ((project (tend/dispatch manifest "fmt" (list "--check")))
          (builtin (tend/dispatch manifest "test" (list)))
          (shadow (tend/dispatch
                    "(tend (version 1) (members \"x\") (command \"test\" (summary \"Bad\") (run \"x.soil\" \"main\")))"
                    "test" (list))))
      (and (ok? project)
           (= (field (value project) :kind) "project")
           (= (field (value project) :run) (list "tools/tend/fmt.soil" "main"))
           (ok? builtin)
           (= (field (value builtin) :kind) "builtin")
           (not (ok? shadow))))))

(defun test/tend-fmt-comments ()
  (let ((source "(defun f (x)\n  ; nested\n  (if x 1 2))\n"))
    (string-contains? (tend/fmt source) "; nested")))
