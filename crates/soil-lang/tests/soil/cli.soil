; SPDX-License-Identifier: MIT OR Apache-2.0
; Command-line spec, parser, help, and man-page projection.

(defun test/cli-spec ()
  (list
    (list :name "marbles")
    (list :about "a small issue tracker")
    (list :version "0.1.0")
    (list :options
      (list
        (list (list :long "json") (list :help "Machine-readable output."))
        (list
          (list :long "project")
          (list :short "p")
          (list :value "slug")
          (list :help "Limit to a project."))))
    (list :args nil)
    (list :commands
      (list
        (list
          (list :name "ready")
          (list :about "List ready work.")
          (list :options nil)
          (list :args nil)
          (list :commands nil))
        (list
          (list :name "show")
          (list :about "Show an issue.")
          (list :options nil)
          (list :args
            (list
              (list
                (list :name "id")
                (list :required #t)
                (list :help "Issue id."))))
          (list :commands nil))))))

(defun test/cli-parse-options ()
  (let ((result (cli-parse-argv (test/cli-spec)
                  (list "ready" "--project" "acme" "--json"))))
    (and
      (cli-ok? result)
      (= (cli-result-option (field result :ok) "project") "acme")
      (= (cli-result-option (field result :ok) "json") #t))))

(defun test/cli-parse-positional ()
  (let ((result (cli-parse-argv (test/cli-spec)
                  (list "show" "marbles-1"))))
    (and
      (cli-ok? result)
      (= (first (cli-result-args (field result :ok))) "marbles-1"))))

(defun test/cli-required-argument ()
  (let ((result (cli-parse-argv (test/cli-spec) (list "show"))))
    (and
      (not (cli-ok? result))
      (string-contains? (field result :error) "missing argument: id"))))

(defun test/cli-unknown-option ()
  (let ((result (cli-parse-argv (test/cli-spec) (list "ready" "--nope"))))
    (and
      (not (cli-ok? result))
      (string-contains? (field result :error) "unknown option"))))

(defun test/cli-help ()
  (let ((help (cli-help (test/cli-spec))))
    (and
      (string-contains? help "Usage: marbles [OPTIONS] <COMMAND>")
      (string-contains? help "--json")
      (string-contains? help "show")
      (string-contains? help "Limit to a project."))))

(defun test/cli-man ()
  (let ((man (cli-man (test/cli-spec))))
    (and
      (string-contains? man ".TH \"marbles\" \"1\"")
      (string-contains? man ".SH NAME")
      (string-contains? man "\\- a small issue tracker"))))

(defun test/cli-argv-empty ()
  (= (length (argv)) 0))

(defun test/bytes-string ()
  (= (string-from-bytes (list 104 105)) "hi"))

(defun test/cli-path ()
  (let ((result (cli-parse-argv (test/cli-spec) (list "show" "x"))))
    (= (field (field result :ok) :path) "marbles show")))

(defun test/cli-builders ()
  (let ((spec (cli-spec "x" "about" "1"
                (list (cli-opt "json" "JSON"))
                (list (cli-command-entry "go" "Go" nil nil)))))
    (and (= (field spec :name) "x")
         (= (field (first (field spec :commands)) :name) "go")
         (= (field (first (field spec :options)) :long) "json"))))

(defun test/cli-global-option-before-command ()
  (let ((result (cli-parse-argv (test/cli-spec)
                  (list "--project" "acme" "ready"))))
    (and
      (cli-ok? result)
      (= (cli-result-option (field result :ok) "project") "acme"))))
