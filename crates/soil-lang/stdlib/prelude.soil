; SPDX-License-Identifier: MIT OR Apache-2.0
; Soil Lisp prelude: generic list, JSON, records, and time helpers.
; Domain policy (devices, signals, profiles) belongs above this file.

;;; Apply `f` to every element of `xs` and return a new list.
(defun or-empty (xs) (if (nil? xs) (list) xs))
(defun min (a b) (if (< a b) a b))
(defun max (a b) (if (> a b) a b))

(defun map (f xs)
  (if (nil? xs)
      nil
      (cons (apply f (list (first xs))) (map f (rest xs)))))

;;; Return the elements of `xs` for which `p` is true.
(defun filter (p xs)
  (cond
    ((nil? xs) nil)
    ((apply p (list (first xs))) (cons (first xs) (filter p (rest xs))))
    (else (filter p (rest xs)))))

;;; Return true when `p` is true for at least one element of `xs`.
(defun any? (p xs)
  (if (nil? xs)
      #f
      (if (apply p (list (first xs)))
          #t
          (any? p (rest xs)))))

;;; Return true when `p` is true for every element of `xs`.
(defun all? (p xs)
  (if (nil? xs)
      #t
      (if (apply p (list (first xs)))
          (all? p (rest xs))
          #f)))

;;; Return the first element of `xs` for which `p` is true, or `nil`.
(defun find (p xs)
  (cond
    ((nil? xs) nil)
    ((apply p (list (first xs))) (first xs))
    (else (find p (rest xs)))))

;;; Return the first `n` elements of `xs`.
(defun take (n xs)
  (if (or (<= n 0) (nil? xs))
      nil
      (cons (first xs) (take (- n 1) (rest xs)))))

;;; Return `xs` without its first `n` elements.
(defun drop (n xs)
  (if (or (<= n 0) (nil? xs))
      xs
      (drop (- n 1) (rest xs))))

(defun reverse-into (xs out)
  (if (nil? xs)
      out
      (reverse-into (rest xs) (cons (first xs) out))))

;;; Concatenate two lists.
(defun append (xs ys)
  (if (nil? xs)
      ys
      (cons (first xs) (append (rest xs) ys))))

;;; Return `xs` in reverse order.
(defun reverse (xs)
  (reverse-into xs nil))

;; Generic list helpers used by UI examples and spores.

;;; Return the zero-based element `n` of `xs`, or `nil` when out of range.
(defun nth (n xs)
  (cond
    ((nil? xs) nil)
    ((<= n 0) (first xs))
    (else (nth (- n 1) (rest xs)))))

;;; Return a copy of `xs` with zero-based element `n` replaced by `value`.
(defun list-set (n value xs)
  (cond
    ((nil? xs) nil)
    ((<= n 0) (cons value (rest xs)))
    (else (cons (first xs) (list-set (- n 1) value (rest xs))))))

(defun range-into (i end out)
  (if (>= i end)
      (reverse out)
      (range-into (+ i 1) end (cons i out))))

;;; Return the integers from `start` (inclusive) to `end` (exclusive).
(defun range (start end)
  (range-into start end nil))

;;; Like `map`, but passes the extra argument `arg` to `f`.
(defun map-with (f arg xs)
  (if (nil? xs)
      nil
      (cons (apply f (list (first xs) arg)) (map-with f arg (rest xs)))))

;;; Like `filter`, but passes the extra argument `arg` to `p`.
(defun filter-with (p arg xs)
  (cond
    ((nil? xs) nil)
    ((apply p (list (first xs) arg)) (cons (first xs) (filter-with p arg (rest xs))))
    (else (filter-with p arg (rest xs)))))

;;; Return the prefix of `xs` for which `pred` stays true.
(defun take-while (pred xs)
  (if (nil? xs)
      nil
      (if (apply pred (list (first xs)))
          (cons (first xs) (take-while pred (rest xs)))
          nil)))

;;; Return `xs` after the prefix for which `pred` stays true.
(defun drop-while (pred xs)
  (cond
    ((nil? xs) nil)
    ((apply pred (list (first xs))) (drop-while pred (rest xs)))
    (else xs)))

;;; Return the final element of a non-empty list.
(defun last-of (xs)
  (if (nil? (rest xs))
      (first xs)
      (last-of (rest xs))))

;;; Fold `xs` from left to right, starting at `acc`.
(defun reduce (f acc xs)
  (if (nil? xs)
      acc
      (reduce f (apply f (list acc (first xs))) (rest xs))))

;;; Return `record` with `key` bound to `value`; other pairs are preserved.
(defun assoc (key value record)
  (if (nil? record)
      (list (list key value))
      (let ((pair (first record)))
        (if (= (first pair) key)
            (cons (list key value) (rest record))
            (cons pair (assoc key value (rest record)))))))

;;; Apply a list of `(key value)` pairs to a record, left to right.
(defun assoc-all (record pairs)
  (if (nil? pairs)
      record
      (assoc-all
        (assoc (first (first pairs)) (nth 1 (first pairs)) record)
        (rest pairs))))

;;; Read `key` from a decoded JSON object.
(defun json-get (value key)
  (field value key))

;;; Read a path of keys from a decoded JSON object.
(defun json-get-in (value keys)
  (if (nil? keys)
      value
      (json-get-in (field value (first keys)) (rest keys))))

;;; Return the `:entries` list of a records page.
(defun page-entries (page)
  (field page :entries))

;;; Return the `:key` record from a records entry.
(defun entry-key (entry)
  (field entry :key))

;;; Return the id part of a records entry key.
(defun entry-id (entry)
  (field (entry-key entry) :id))

;;; Return the collection part of a records entry key.
(defun entry-collection (entry)
  (field (entry-key entry) :collection))

;;; Return the schema name of a records entry.
(defun entry-schema (entry)
  (field entry :schema))

;;; Return the update timestamp of a records entry, in milliseconds.
(defun entry-updated-at (entry)
  (field entry :updated-at-ms))

;;; Decode and return the JSON body of a records entry.
(defun entry-body (entry)
  (json-decode (field entry :body)))

;;; Build a records key from a collection name and an id.
(defun record-key (collection id)
  (list (list :collection collection) (list :id id)))

;;; Build a records entry from a key, schema, body, and timestamp.
(defun make-entry (collection id schema body now)
  (list
    (list :key (record-key collection id))
    (list :schema schema)
    (list :revision 0)
    (list :updated-at-ms now)
    (list :origin "soil")
    (list :deleted #f)
    (list :body (json-encode body))))

;;; Write an entry through the host records capability.
(defun upsert-record (collection id schema body now)
  (soil:records/upsert (make-entry collection id schema body now)))

;;; Return the host wall clock as Unix milliseconds.
(defun now-ms ()
  (field (value (soil:time/wall-clock)) :unix-ms))

; McCarthy-style accessors.
;;; Return `(car (car x))`.
(defun caar (x) (car (car x)))
;;; Return `(car (cdr x))`.
(defun cadr (x) (car (cdr x)))
;;; Return `(cdr (car x))`.
(defun cdar (x) (cdr (car x)))
;;; Return `(car (cdr (cdr x)))`.
(defun caddr (x) (car (cdr (cdr x))))
;;; Return `(car (cdr (car x)))`.
(defun cadar (x) (car (cdr (car x))))
;;; Return `(car (cdr (cdr (car x))))`.
(defun caddar (x) (car (cdr (cdr (car x)))))
