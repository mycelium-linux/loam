; SPDX-License-Identifier: MIT OR Apache-2.0
; A small, data-driven command-line layer.
;
; The spec is plain data, so a build step can derive it from the same `;;;`
; comments that document a command. The runtime never reflects on Rust types:
; it walks the spec, parses argv, and prints help or a man page.
;
;   (defun spec ()
;     (list
;       (list :name "marbles")
;       (list :about "a small issue tracker")
;       (list :version "0.1.0")
;       (list :options
;         (list (list :long "json" :help "Machine-readable output.")
;               (list :long "project" :short "p" :value "slug"
;                     :help "Limit to a project.")))
;       (list :args nil)
;       (list :commands
;         (list (list :name "ready" :about "List ready work."
;                     :options nil :args nil :commands nil)))))
;
; An option with `:value` takes the next token; without it, it is a flag.
; A positional argument is `(:name "id" :required #t :help "...")`.
; A command is a spec with a `:name` and an `:about`.

(defun cli-eq? (character)
  (= character "="))

(defun cli-not-eq? (character)
  (not (cli-eq? character)))

(defun cli-prefix? (text prefix)
  (let ((chars (string-chars text))
        (wanted (string-chars prefix)))
    (cli-prefix-chars? chars wanted)))

(defun cli-prefix-chars? (chars wanted)
  (cond
    ((nil? wanted) #t)
    ((nil? chars) #f)
    ((= (first chars) (first wanted))
      (cli-prefix-chars? (rest chars) (rest wanted)))
    (else #f)))

(defun cli-starts-with-dash? (text)
  (cli-prefix? text "-"))

(defun cli-starts-with-two-dashes? (text)
  (cli-prefix? text "--"))

(defun cli-drop (n text)
  (string-join (drop n (string-chars text)) ""))

(defun cli-split-equals (text)
  (let ((chars (string-chars text)))
    (let ((name (take-while 'cli-not-eq? chars)))
      (if (= (length name) (length chars))
          (list text nil)
          (list
            (string-join name "")
            (string-join (drop (+ (length name) 1) chars) ""))))))

(defun cli-option-long (name options)
  (cond
    ((nil? options) nil)
    ((= (field (first options) :long) name) (first options))
    (else (cli-option-long name (rest options)))))

(defun cli-option-short (name options)
  (cond
    ((nil? options) nil)
    ((= (field (first options) :short) name) (first options))
    (else (cli-option-short name (rest options)))))

;;; Find a subcommand spec by its command name.
(defun cli-command (name commands)
  (cond
    ((nil? commands) nil)
    ((= (field (first commands) :name) name) (first commands))
    (else (cli-command name (rest commands)))))

(defun cli-has-commands? (spec)
  (not (nil? (field spec :commands))))

(defun cli-has-options? (spec)
  (not (nil? (field spec :options))))

(defun cli-has-args? (spec)
  (not (nil? (field spec :args))))

(defun cli-option-key (option)
  (let ((long (field option :long)))
    (if (nil? long) "" long)))

(defun cli-assoc (key value record)
  (cond
    ((nil? record) (list (list key value)))
    ((= (first (first record)) key)
      (cons (list key value) (rest record)))
    (else
      (cons (first record) (cli-assoc key value (rest record))))))

(defun cli-set-option (option value options)
  (cli-assoc (cli-option-key option) value options))

(defun cli-option-value? (option)
  (not (nil? (field option :value))))

(defun cli-argument (name args)
  (cond
    ((nil? args) nil)
    ((= (field (first args) :name) name) (first args))
    (else (cli-argument name (rest args)))))

(defun cli-inherit-options (spec parent-options)
  (assoc :options (append parent-options (field spec :options)) spec))

(defun cli-required? (argument)
  (field argument :required))

(defun cli-required-args (spec)
  (if (nil? (field spec :args))
      nil
      (filter 'cli-required? (field spec :args))))

(defun cli-validate-args (spec args)
  (let ((required (cli-required-args spec)))
    (if (< (if (nil? args) 0 (length args))
           (if (nil? required) 0 (length required)))
        (cli-error
          (str "missing argument: "
               (field (nth (if (nil? args) 0 (length args)) required) :name)))
        (list (list :ok #t)))))

(defun cli-result (command options args path)
  (list
    (list :command command)
    (list :name (field command :name))
    (list :path path)
    (list :options options)
    (list :args args)))

;;; Return true when a parse result is successful.
(defun cli-ok? (value)
  (not (nil? (field value :ok))))

(defun cli-lookup (name record)
  (cond
    ((nil? record) nil)
    ((= (str (first (first record))) name) (nth 1 (first record)))
    (else (cli-lookup name (rest record)))))

;;; Read a parsed option by its long name, or `nil`.
(defun cli-result-option (result name)
  (cli-lookup name (field result :options)))

;;; Return the parsed positional arguments.
(defun cli-result-args (result)
  (field result :args))

(defun cli-error (message)
  (list (list :error message)))

(defun cli-help-result (spec path)
  (list (list :help (cli-help-at spec path))))

(defun cli-parse-option-value (option rest options args path spec)
  (if (nil? rest)
      (cli-error (str "option --" (field option :long) " needs a value"))
      (cli-parse (rest rest)
        (cli-set-option option (first rest) options)
        args
        path
        spec)))

(defun cli-parse-positional (spec token rest options args path)
  (let ((command (if (cli-has-commands? spec)
                     (cli-command token (field spec :commands))
                     nil)))
    (cond
      (command
        ;; Options parsed before the command belong to the same invocation;
        ;; entering a command must not discard them.
        (cli-parse rest options nil (str path " " token)
          (cli-inherit-options command (field spec :options))))
      ((cli-has-commands? spec)
        (cli-error (str "unknown command: " token)))
      (else
        (cli-parse rest options (append args (list token)) path spec)))))

(defun cli-parse (argv options args path spec)
  (cond
    ((nil? argv)
      (if (and (cli-has-commands? spec) (nil? args))
          (cli-error (str "a command is required; try `" path " --help`"))
          (let ((validation (cli-validate-args spec args)))
            (if (cli-ok? validation)
                (list (list :ok (cli-result spec options args path)))
                validation))))
    ((= (first argv) "--")
      (cli-parse (list) options (append args (rest argv)) path spec))
    ((= (first argv) "--help")
      (cli-help-result spec path))
    ((= (first argv) "-h")
      (cli-help-result spec path))
    ((= (first argv) "--version")
      (list (list :version (field spec :version))))
    ((cli-starts-with-two-dashes? (first argv))
      (let ((split (cli-split-equals (cli-drop 2 (first argv)))))
        (let ((option (cli-option-long (first split) (field spec :options))))
          (cond
            ((nil? option)
              (cli-error (str "unknown option: --" (first split))))
            ((nil? (nth 1 split))
              (if (cli-option-value? option)
                  (cli-parse-option-value option (rest argv) options args path spec)
                  (cli-parse (rest argv)
                    (cli-set-option option #t options) args path spec)))
            (else
              (cli-parse (rest argv)
                (cli-set-option option (nth 1 split) options)
                args path spec))))))
    ((cli-starts-with-dash? (first argv))
      (let ((split (cli-split-equals (cli-drop 1 (first argv)))))
        (let ((option (cli-option-short (first split) (field spec :options))))
          (cond
            ((nil? option)
              (cli-error (str "unknown option: -" (first split))))
            ((nil? (nth 1 split))
              (if (cli-option-value? option)
                  (cli-parse-option-value option (rest argv) options args path spec)
                  (cli-parse (rest argv)
                    (cli-set-option option #t options) args path spec)))
            (else
              (cli-parse (rest argv)
                (cli-set-option option (nth 1 split) options)
                args path spec))))))
    (else
      (cli-parse-positional spec (first argv) (rest argv) options args path))))

;;; Declarative spec builders.
;;;
;;; The parser still consumes plain data. These helpers only remove the nested
;;; `(list (list :key value) ...)` noise from a command's source, so a spec reads
;;; as commands, options, and args rather than as association-list plumbing.
(defun cli-opt (long help)
  (list (list :long long) (list :help help)))

(defun cli-opt-short (long short help)
  (list (list :long long) (list :short short) (list :help help)))

(defun cli-opt-value (long value help)
  (list (list :long long) (list :value value) (list :help help)))

(defun cli-opt-short-value (long short value help)
  (list (list :long long) (list :short short) (list :value value) (list :help help)))

(defun cli-arg (name required help)
  (list (list :name name) (list :required required) (list :help help)))

(defun cli-command-group (name about options commands)
  (list
    (list :name name)
    (list :about about)
    (list :options options)
    (list :args nil)
    (list :commands commands)))

(defun cli-command-entry (name about options args)
  (list
    (list :name name)
    (list :about about)
    (list :options options)
    (list :args args)
    (list :commands nil)))

(defun cli-spec (name about version options commands)
  (list
    (list :name name)
    (list :about about)
    (list :version version)
    (list :options options)
    (list :args nil)
    (list :commands commands)))

;;; Parse an argv list against a command spec.
;;;
;;; Returns `(:ok result)` or `(:error message)`. Global options are inherited by subcommands; `--help` returns a `:help` result instead.
(defun cli-parse-argv (spec argv)
  (let ((result (cli-parse argv nil nil (field spec :name) spec)))
    (if (cli-ok? result)
        (list (list :ok (field result :ok)))
        result)))

(defun cli-argument-usage (argument)
  (let ((name (field argument :name)))
    (if (field argument :required)
        (str "<" name ">")
        (str "[" name "]"))))

(defun cli-option-usage (option)
  (let ((long (field option :long))
        (short (field option :short))
        (value (field option :value)))
    (str
      (if (nil? short) "" (str "-" short " "))
      "--" long
      (if (nil? value) "" (str " <" value ">")))))

(defun cli-usage (spec path)
  (str path
    (if (cli-has-options? spec) " [OPTIONS]" "")
    (if (cli-has-commands? spec) " <COMMAND>" "")
    (if (cli-has-args? spec)
        (str " " (string-join (map 'cli-argument-usage (field spec :args)) " "))
        "")))

(defun cli-command-line (command)
  (str "  " (field command :name)
       (if (nil? (field command :about)) "" (str "  " (field command :about)))))

(defun cli-option-line (option)
  (str "  " (cli-option-usage option)
       (if (nil? (field option :help)) "" (str "  " (field option :help)))))

(defun cli-argument-line (argument)
  (str "  " (field argument :name)
       (if (nil? (field argument :help)) "" (str "  " (field argument :help)))))

(defun cli-help-at (spec path)
  (str
    (field spec :about) "\n\n"
    "Usage: " (cli-usage spec path) "\n"
    (if (cli-has-commands? spec)
        (str "\nCommands:\n"
             (string-join (map 'cli-command-line (field spec :commands)) "\n")
             "\n")
        "")
    (if (cli-has-options? spec)
        (str "\nOptions:\n"
             (string-join (map 'cli-option-line (field spec :options)) "\n")
             "\n")
        "")
    (if (cli-has-args? spec)
        (str "\nArguments:\n"
             (string-join (map 'cli-argument-line (field spec :args)) "\n")
             "\n")
        "")))

;;; Render the top-level help text for a spec.
(defun cli-help (spec)
  (cli-help-at spec (field spec :name)))

(defun cli-man-escape (text)
  (string-replace (str text) "\\" "\\\\"))

(defun cli-man-option (option)
  (str ".TP\n.B "
       (cli-man-escape (cli-option-usage option)) "\n"
       (cli-man-escape (field option :help)) "\n"))

(defun cli-man-command (command)
  (str ".TP\n.B " (field command :name) "\n"
       (cli-man-escape (field command :about)) "\n"))

;;; Render a roff man page for a spec.
(defun cli-man (spec)
  (let ((name (field spec :name))
        (version (field spec :version)))
    (str
      ".TH \"" (string-join (string-chars name) "") "\" \"1\" \"\" \""
      (cli-man-escape version) "\" \"\"\n"
      ".SH NAME\n"
      (cli-man-escape name) " \\- " (cli-man-escape (field spec :about)) "\n"
      ".SH SYNOPSIS\n"
      ".B " (cli-man-escape (cli-usage spec name)) "\n"
      (if (cli-has-commands? spec)
          (str ".SH COMMANDS\n"
               (string-join (map 'cli-man-command (field spec :commands)) ""))
          "")
      (if (cli-has-options? spec)
          (str ".SH OPTIONS\n"
               (string-join (map 'cli-man-option (field spec :options)) ""))
          "")
      (if (cli-has-args? spec)
          (str ".SH ARGUMENTS\n"
               (string-join
                 (map 'cli-man-argument (field spec :args))
                 ""))
          ""))))

(defun cli-man-argument (argument)
  (str ".TP\n.B " (field argument :name) "\n"
       (cli-man-escape (field argument :help)) "\n"))
